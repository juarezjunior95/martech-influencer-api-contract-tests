# Pact Broker local (docker compose up -d)
PACT_BROKER_BASE_URL=http://localhost:9292
PACT_BROKER_USERNAME=pact
PACT_BROKER_PASSWORD=pact

# Metadados ao publicar contratos consumer (use SHA do git no CI)
PACT_CONSUMER_VERSION=local-dev
PACT_BRANCH=main

# --- Provider verification (npm run pact:verify-provider) ---

# API real (UAT). Default já aponta para UAT se omitido.
PROVIDER_BASE_URL=https://services.martech.uat.mybees-platform.dev/api/martech-connect-influencer-service

# Bearer token de teste (obrigatório para cenários 200; não commitar valor real)
PROVIDER_TOKEN=

# Token M2M com scope ConnectInfluencer.PartnerBrandSafety.Read (brand-safety INT-01..05)
M2M_TOKEN_BRAND_SAFETY_READ=

# Token M2M write (Sprint 204: complete / expire — stub pact-m2m-write-token)
M2M_TOKEN_BRAND_SAFETY_WRITE=

# Token sem scope brand-safety Read (brand-safety INT-07 — ex.: submitter puro)
PROVIDER_TOKEN_WRONG_SCOPE=

# Token admin para POST /v1/users (verify provider)
ADMIN_JWT=

# Opcional: endpoint do backend para preparar dados antes de cada interação
# POST body: { "state": "campaigns exist for submitter group draft", "action": "setup", "params": {} }
# PROVIDER_STATES_SETUP_URL=https://services.martech.uat.mybees-platform.dev/api/martech-connect-influencer-service/pact/provider-states

# Publicar resultado da verify no Broker (deixa o grafo verde)
PUBLISH_VERIFICATION_RESULT=false
PROVIDER_VERSION=local-dev

# Verify via Broker em vez de arquivo local (usa última versão do consumer)
# PACT_BROKER_BASE_URL=http://localhost:9292

# SSL / timeout
PACT_DISABLE_SSL_VERIFICATION=false
PACT_VERIFY_TIMEOUT_MS=30000
PACT_LOG_LEVEL=info
