# Application Configuration
APP_PORT=3030
NODE_ENV=development
APP_NAME=martech-oneway-reports-data-service

# Postgres Configuration
# For Docker Compose, use 'postgres' as host (service name)
# For local development, use 'localhost'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=kpis
POSTGRES_SCHEMA=reporting
POSTGRES_SSL=false

# Postgres Pool Configuration
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20

# Databricks Configuration
# Replace with your actual Databricks connection details
DATABRICKS_SERVER_HOSTNAME=your-databricks-host
DATABRICKS_HTTP_PATH=your-databricks-path
DATABRICKS_CATALOG=your-catalog-name
DATABRICKS_SCHEMA=your-schema-name
DATABRICKS_AZURE_TENANT_ID=your-tenant-id
DATABRICKS_OAUTH_CLIENT_ID=your-client-id
DATABRICKS_OAUTH_CLIENT_SECRET=your-client-secret
DATABRICKS_KPI_TABLE=databricks-kpi-table

# New Relic Configuration (Optional)
# Uncomment and configure if you want to use New Relic monitoring
# NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
# NEW_RELIC_APP_NAME=martech-oneway-reports-data-service

# Logging Configuration (Optional)
# LOG_LEVEL=info

# Timeout Configuration (Optional)
# TIMEOUT=20000

# Swagger Configuration (Optional)
# Swagger documentation prefix
# SWAGGER_PREFIX=/v1/docs

# Mock User Override (DEV ONLY)
# When set to "true" AND NODE_ENV=development, the request UserEntity is
# loaded from `src/infrastructure/repositories/mock-user.dev.ts` instead
# of the JWT. Both guards must pass — any other NODE_ENV value disables
# the override entirely. Never enable in staging/production.
# MOCK_USER_OVERRIDE=false

# Images
# Public image CDN base URL.
CDN_BASE_URL=http://localhost:3030/images
