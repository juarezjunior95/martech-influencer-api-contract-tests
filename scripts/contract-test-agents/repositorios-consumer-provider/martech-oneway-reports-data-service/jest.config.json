{
    "preset": "ts-jest",
    "coverageProvider": "v8",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": [
      ".*\\.spec\\.ts$",
      ".*\\.test\\.ts$"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "./src/**/*.(t|j)s"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/config/",
      ".module.ts",
      ".entity.ts",
      "<rootDir>/src/main.ts",
      "<rootDir>/src/common/swagger/swagger.config.ts",
      "/swagger/",
      "test/",
      "/dist/"
    ],
    "testEnvironment": "node",
    "testResultsProcessor": "jest-junit",
    "moduleNameMapper": {
      "^@*/(.*)": "<rootDir>/src/$1",
      "^@test/(.*)": "<rootDir>/test/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@application/(.*)$": "<rootDir>/src/application/$1",
      "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
      "^@repositories/(.*)$": "<rootDir>/src/infrastructure/repositories/$1",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1"
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "setupFiles": ["<rootDir>/test/integration/setup/setup-env.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!(@faker-js)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/node_modules/@databricks/sql/node_modules",
      "<rootDir>/dist"
    ],
    "extensionsToTreatAsEsm": [".ts"],
    "globals": {}
  }