{
  "preset": "ts-jest",
  "coverageProvider": "v8",
  "displayName": "integration",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.integration\\.spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": false
        }
      }
    ]
  },
  "collectCoverageFrom": ["./src/**/*.(t|j)s"],
  "coverageDirectory": "<rootDir>/coverage/integration",
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "/config/",
    ".module.ts",
    ".entity.ts",
    "<rootDir>/src/main.ts",
    "<rootDir>/src/common/swagger/swagger.config.ts",
    "/swagger/",
    "test/",
    "/dist/"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/test/integration/setup/setup-env.ts"],
  "moduleNameMapper": {
    "^@*/(.*)": "<rootDir>/src/$1",
    "^@test/(.*)": "<rootDir>/test/$1",
    "^@domain/(.*)$": "<rootDir>/src/domain/$1",
    "^@common/(.*)$": "<rootDir>/src/common/$1",
    "^@application/(.*)$": "<rootDir>/src/application/$1",
    "^@infrastructure/(.*)$": "<rootDir>/src/infrastructure/$1",
    "^@repositories/(.*)$": "<rootDir>/src/infrastructure/repositories/$1",
    "^@config/(.*)$": "<rootDir>/src/config/$1"
  },
  "moduleDirectories": ["node_modules", "src"],
  "transformIgnorePatterns": ["node_modules/(?!(@faker-js)/)"],
  "modulePathIgnorePatterns": [
    "<rootDir>/node_modules/@databricks/sql/node_modules",
    "<rootDir>/dist"
  ],
  "extensionsToTreatAsEsm": [".ts"],
  "globals": {}
}
