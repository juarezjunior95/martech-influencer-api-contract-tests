{
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": [
      ".*\\.spec\\.ts$",
      ".*\\.test\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "./src/**/*.(t|j)s"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/config/",
      ".module.ts",
      ".entity.ts",
      "<rootDir>/src/main.ts",
      "<rootDir>/src/common/swagger/swagger.config.ts",
      "/swagger/",
      "test/"
    ],
    "testEnvironment": "node",
    "testResultsProcessor": "jest-junit",
    "moduleNameMapper": {
      "^@*/(.*)": [
        "<rootDir>/src/$1"
      ],
      "^@test/(.*)": [
        "<rootDir>/test/$1"
      ],
      "^@domain/(.*)$": [
        "<rootDir>/src/domain/$1" 
      ],
      "^@infrastructure/(.*)$": [
        "<rootDir>/src/infrastructure/$1"
      ],
      "^@application/(.*)$": [
        "<rootDir>/src/application/$1"
      ],
      "^@common/(.*)$": [
        "<rootDir>/src/common/$1"
      ],
      "^@config/(.*)$": [
        "<rootDir>/src/config/$1"
      ],
      "^@modules/(.*)$": [
        "<rootDir>/src/modules/$1"
      ]
    },
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@faker-js)/)"
    ]
  }