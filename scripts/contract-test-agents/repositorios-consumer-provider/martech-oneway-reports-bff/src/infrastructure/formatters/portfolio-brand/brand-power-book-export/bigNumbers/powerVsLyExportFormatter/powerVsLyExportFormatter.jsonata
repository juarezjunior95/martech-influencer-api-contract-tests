/* *
 * 🔢 POWER VS LY FORMATTER
 * 🎯 Component: BigNumber
 * 📍 Used on: BrandPowerBook > Power vs LY BigNumber
 * 🔄 Input: power_vs_ly data
 * 📤 Output: BigNumberData interface */
(
  $dsKeys := $keys(datasources);
  $data := $lookup(datasources, $dsKeys[0]);
  $config:= {
    "vs_ly":{"title": "Power vs LY" },
     "total_unit_measure": "[%]",
    "total_prefix": "#:",
      "color": {
        "up": "#007800",
        "down": "#B91C1C"
      },
       "variation": {
        "unit_measure": "pp"
      }
  };
 
  $isEmpty:= $count($data) = 0;
  $isEmpty = false
    ? {
      "header": { "title": $config.vs_ly.title },
      "data": [
        {
          "bigNumber": {
            "value": $formatValue($number($data.ac_vs_ly), "string"),
            "measure": $config.variation.unit_measure,
            "color":$getColorUpDown($data.ac_vs_ly,$config.color.up, $config.color.down)
          },
          "secondaryInfo": {
            "value": $join([$config.total_prefix, " ", $string($formatNumber($data.ac, "#,##0.0"))]),
            "label": $config.total_unit_measure
          },
          "comparison": { "label": "vs", "value": $formatLyQuarter($data.dt_end)  }
        }
      ]
    }
    : 
      {
        "header": { "title": $config.vs_ly.title },
        "empty": true
      }
    
)