 /**
 * 🔢 POWER VS LY FORMATTER
 * 🎯 Component: BigNumber
 * 📍 Used on: BrandPowerBook > Power vs LY BigNumber
 * 🔄 Input: power_vs_ly data
 * 📤 Output: BigNumberData interface
 */
 
(
  $dsKeys := $keys(datasources);
  $data := $lookup(datasources, $dsKeys[0]);
  $count($data) > 0
    ? {
      "title": "Power vs LY",
      "bigNumber": $data.ac_vs_ly,
      "bigNumberUnit": "pp",
      "bigNumberDirection": $data.ac_vs_ly > 0 ? "up" : "down",
      "bigNumberColor": $data.ac_vs_ly >= 0 ? "#E6F9E6" : "#FFE6E6",
      "versus": "vs " & $formatLyQuarter($data.dt_end),
      "total": $data.ac,
      "totalPrefix": "#:",
      "totalMeasure": "[%]",
      "dateRefresh": $formatDateToQuarter($data.dt_end)
    }
    : { "title": "Power vs LY", "empty": true }
)

