/**
 * 🔢 POWER VS LQ FORMATTER
 * 🎯 Component: BigNumber
 * 📍 Used on: BrandPowerBook > Power vs LQ BigNumber
 * 🔄 Input: power_vs_lq data
 * 📤 Output: BigNumberData interface
 */
 
(
  $dsKeys := $keys(datasources);
  $data := $lookup(datasources, $dsKeys[0]);
  $count($data) > 0
    ? {
      "title": "Power vs LQ",
      "bigNumber": $data.ac_vs_lq,
      "bigNumberUnit": "pp",
      "bigNumberDirection": $data.ac_vs_lq > 0 ? "up" : "down",
      "bigNumberColor": $data.ac_vs_lq >= 0 ? "#E6F9E6" : "#FFE6E6",
      "versus": "vs " & $formatLqQuarter($data.dt_end),
      "total": $data.ac,
      "totalPrefix": "#:",
      "totalMeasure": "[%]",
      "dateRefresh": $formatDateToQuarter($data.dt_end)
    }
    : { "title": "Power vs LQ", "empty": true }
)
