/**
 * 🔢 SUMMARY POWER BREAKDOWN FORMATTER
 * 🎯 Component: Multi-header Table (pivot KPIs into columns per brand)
 * 📍 Used on: BrandPowerBook > Overview > Summary > Brand Breakdown
 * 🔄 Input: summary-power_by-brand-breakdown data
 * 📤 Output: Nested header + pivoted rows (one per brand)
 * 🔧 Helpers: formatLyQuarter
 */
(
  $ds := $keys($.datasources)[0];
  $data := $filter(
    $lookup($.datasources, $ds),
    function($row) { $uppercase($row.level_1) = "ABI" }
  );

  $config := {
    "variation": { "unit_measure": "pp" },
    "direction": { "up": "#49764B", "down": "#A20A0A" },
    "legend": { "color": "#EDCD20" },
    "kpis": [
      { "name": "power", "prefix": "brand_power", "title": "Brand Power", "fixedMax": 100 },
      { "name": "meaningful", "prefix": "meaning", "title": "Meaning" },
      { "name": "difference", "prefix": "difference", "title": "Difference" },
      { "name": "salience", "prefix": "salience", "title": "Salience" }
    ]
  };

  $count($data) = 0
    ? { "empty": true }
    : (
        $brands := $distinct($data.raw_brand);
        $lyLabel := "vs " & $formatLyQuarter($data[0].dt_end);

        $maxForKpi := function($kpiName) {
          $max($filter($data, function($row) { $row.kpi_name = $kpiName }).ac)
        };

        $header := $append(
          [{ "title": "", "children": [{ "id": "id", "title": "" }] }],
          $map($config.kpis, function($kpi) {
            {
              "title": $kpi.title,
              "children": [
                { "id": $kpi.prefix & "_ac", "title": "AC" },
                { "id": $kpi.prefix & "_ly", "title": $lyLabel }
              ]
            }
          })
        );

        $rows := $map($brands, function($brandName) {
          (
            $brandRows := $filter($data, function($row) { $row.raw_brand = $brandName });

            $base := {
              "id": { "value": $brandName },
              "type": { "value": "abi" }
            };

            $kpiCells := $merge(
              $map($config.kpis, function($kpi) {
                (
                  $kpiRow := $filter($brandRows, function($row) { $row.kpi_name = $kpi.name })[0];
                  $maxVal := $exists($kpi.fixedMax) ? $kpi.fixedMax : $maxForKpi($kpi.name);
                  {
                    ($kpi.prefix & "_ac"): {
                      "chartData": {
                        "data": [$kpiRow.ac],
                        "backgroundColor": [$config.legend.color],
                        "max": $maxVal
                      }
                    },
                    ($kpi.prefix & "_ly"): {
                      "unitMeasure": $config.variation.unit_measure,
                      "variationDirection": $kpiRow.ac_vs_ly > 0 ? $config.direction.up : $config.direction.down,
                      "value": $kpiRow.ac_vs_ly
                    }
                  }
                )
              })
            );

            $merge([$base, $kpiCells])
          )
        });

        {
          "header": $header,
          "rows": [[$rows]]
        }
      )
)
