/**
 * BRAND ANALYSIS BRAND POWER FORMATTER (BFF)
 * Based on frontend formatters:
 * - brandPowerAbiFormatter.jsonata
 * - brandPowerCompetitorFormatter.jsonata
 */
(
  $rawDatasources := $exists(datasources)
    ? datasources
    : (
      $exists(components) and $count(components) > 0 and $exists(components[0].data.datasources)
        ? components[0].data.datasources
        : {}
    );

  $asArray := function($value) {
    $type($value) = "array" ? $value : ($exists($value) ? [$value] : [])
  };

  $toNumber := function($value) {
    $type($value) = "number"
      ? $value
      : (
        $type($value) = "string" and $match($trim($value), /^[-+]?[0-9]*[.]?[0-9]+$/)
          ? $number($trim($value))
          : undefined
      )
  };

  $getDirection := function($comparison) {
    (
      $val := $toNumber($comparison);
      $exists($val) ? ($val >= 0 ? "up" : "down") : "down"
    )
  };

  $yearShort := function($year) {
    $substring($string($year), 2, 2)
  };

  $quarterYearFormatted := function($quarter, $year, $fallback) {
    $exists($quarter) and $exists($year)
      ? $string($quarter) & "'" & $yearShort($year)
      : $fallback
  };

  $isGenericBrandValue := function($value) {
    $not($exists($value))
      ? true
      : (
        $normalized := $lowercase($trim($string($value)));
        $normalized = "" or $normalized = "all" or $normalized = "n/a"
      )
  };

  $resolveBrandKey := function($item) {
    (
      $subBrand := $item.sub_brand;
      $rawBrand := $item.raw_brand;
      $level3 := $item.level_3;

      $not($isGenericBrandValue($subBrand))
        ? $subBrand
        : (
          $not($isGenericBrandValue($rawBrand))
            ? $rawBrand
            : (
              $not($isGenericBrandValue($level3))
                ? $level3
                : $subBrand
            )
        )
    )
  };

  $quarterlySource :=
    $lookup($rawDatasources, "portfolio-brand_brand-analysis_brand-power_per-year-qtr");
  $ytdSource :=
    $lookup($rawDatasources, "portfolio-brand_brand-analysis_brand-power_per-year");
  $yearlySource :=
    $lookup($rawDatasources, "portfolio-brand_brand-analysis_brand-power_per-year-full");

  $normalizeQuarterly := function($item) {
    (
      $year := $toNumber($item.year);
      $quarter := $item.quarter;
      $comparison := $exists($item.ac_vs_ly) ? $item.ac_vs_ly : $item.comparison;
      $fallbackQy := $item.quarter_year_formatted;
      $brandKey := $resolveBrandKey($item);

      {
        "ac": $toNumber($item.ac),
        "comparison": $toNumber($comparison),
        "variation_direction": $exists($item.variation_direction) ? $item.variation_direction : $getDirection($comparison),
        "quarter_year_formatted": $quarterYearFormatted($quarter, $year, $fallbackQy),
        "year": $year,
        "brand_key": $brandKey
      }
    )
  };

  $normalizeYtd := function($item) {
    (
      $comparison := $exists($item.ac_vs_ly) ? $item.ac_vs_ly : $item.comparison;
      $brandKey := $resolveBrandKey($item);

      {
        "ac": $toNumber($item.ac),
        "comparison": $toNumber($comparison),
        "variation_direction": $exists($item.variation_direction) ? $item.variation_direction : $getDirection($comparison),
        "year": $toNumber(
          $exists($item.year_value)
            ? $item.year_value
            : ($item.year)
        ),
        "brand_key": $brandKey
      }
    )
  };

  $normalizeYearly := function($item) {
    (
      $comparison := $exists($item.ac_vs_ly) ? $item.ac_vs_ly : $item.comparison;
      $brandKey := $resolveBrandKey($item);

      {
        "ac": $toNumber($item.ac),
        "comparison": $toNumber($comparison),
        "variation_direction": $exists($item.variation_direction) ? $item.variation_direction : $getDirection($comparison),
        "year": $toNumber(
          $exists($item.year_value)
            ? $item.year_value
            : (
              $exists($item.year_ini)
                ? $item.year_ini
                : ($item.year)
            )
        ),
        "brand_key": $brandKey
      }
    )
  };

  $dsQuarterly := $map($asArray($quarterlySource), $normalizeQuarterly);
  $dsYtd := $map($asArray($ytdSource), $normalizeYtd);
  $dsYearly := $map($asArray($yearlySource), $normalizeYearly);

  $config := {
    "background_color": {
      "bars": "#e8d19d",
      "bars_dark": "#d1a33c",
      "bars_comp": "#a0aeb7",
      "bars_comp_dark": "#7b919d"
    },
    "unit_measure": {
      "points_percent": "pp"
    }
  };

  $unitMeasure := $config.unit_measure.points_percent;
  $colorBars := $config.background_color.bars;
  $colorBarsDark := $config.background_color.bars_dark;
  $colorBarsComp := $config.background_color.bars_comp;
  $colorBarsCompDark := $config.background_color.bars_comp_dark;

  $isEmpty := $count($dsQuarterly) = 0 and $count($dsYtd) = 0 and $count($dsYearly) = 0;

  $filterEven := function($array) {
    $map($array, function($item, $index) { $index % 2 = 0 ? $item })[$exists($)]
  };
  $filterOdd := function($array) {
    $map($array, function($item, $index) { $index % 2 != 0 ? $item })[$exists($)]
  };

  $allBrandKeys := $distinct(
    $filter(
      $append($append($dsQuarterly.brand_key, $dsYtd.brand_key), $dsYearly.brand_key),
      function($v) { $exists($v) and $trim($string($v)) != "" and $lowercase($trim($string($v))) != "all" and $lowercase($trim($string($v))) != "n/a" }
    )
  );

  $hasCompetitorPairs :=
    $count($dsQuarterly) > 1 and $count($dsYtd) > 1 and $count($dsYearly) > 1 and
    $count($dsQuarterly) % 2 = 0 and $count($dsYtd) % 2 = 0 and $count($dsYearly) % 2 = 0;

  $isCompetitor := $count($allBrandKeys) > 1 and $hasCompetitorPairs;

  $isEmpty
    ? { "empty": true }
    : (
      $isCompetitor
        ? (
          $yearMinQuarterly := $min($dsQuarterly.year);
          $yearMaxQuarterly := $max($dsQuarterly.year);
          $yearMinYearly := $min($dsYearly.year);
          $yearMaxYearly := $max($dsYearly.year);

          $quarterEven := $filterEven($dsQuarterly);
          $quarterOdd := $filterOdd($dsQuarterly);
          $ytdEven := $filterEven($dsYtd);
          $ytdOdd := $filterOdd($dsYtd);
          $yearEven := $filterEven($dsYearly);
          $yearOdd := $filterOdd($dsYearly);

          {
            "kpiData": {
              "quarterly": {
                "datasets": [
                  {
                    "type": "bar",
                    "data": $map($quarterEven, function($v) { $v.ac }),
                    "backgroundColor": $map($quarterEven, function($v) {
                      $v.year = $yearMaxQuarterly ? $colorBarsDark : $colorBars
                    })
                  },
                  {
                    "type": "bar",
                    "data": $map($quarterOdd, function($v) { $v.ac }),
                    "backgroundColor": $map($quarterOdd, function($v) {
                      $v.year = $yearMaxQuarterly ? $colorBarsCompDark : $colorBarsComp
                    })
                  }
                ],
                "labels": $quarterEven.quarter_year_formatted,
                "variation_caption": {
                  "title": "Comparison",
                  "subtitle": "Vs LY [ " & $yearMinQuarterly & " - " & $yearMaxQuarterly & " ]",
                  "variationsRows": {
                    "kpi": {
                      "data": $map($quarterEven, function($v, $index) {
                        {
                          "variationsGroup": [
                            {
                              "variation": $string($v.comparison),
                              "direction": $v.variation_direction,
                              "unit_of_measure": $unitMeasure
                            },
                            {
                              "variation": $string($quarterOdd[$index].comparison),
                              "direction": $quarterOdd[$index].variation_direction,
                              "unit_of_measure": $unitMeasure
                            }
                          ]
                        }
                      })
                    }
                  }
                },
                "paddingTop": 20
              },
              "ytd": {
                "datasets": [
                  {
                    "type": "bar",
                    "data": $map($ytdEven, function($v) { $v.ac }),
                    "backgroundColor": $map($ytdEven, function($v, $index) {
                      $index = ($count($ytdEven) - 1) ? $colorBarsDark : $colorBars
                    })
                  },
                  {
                    "type": "bar",
                    "data": $map($ytdOdd, function($v) { $v.ac }),
                    "backgroundColor": $map($ytdOdd, function($v, $index) {
                      $index = ($count($ytdOdd) - 1) ? $colorBarsCompDark : $colorBarsComp
                    })
                  }
                ],
                "labels": $ytdEven.year,
                "variation_caption": {
                  "title": "YTD",
                  "subtitle": "",
                  "variationsRows": {
                    "kpi": {
                      "data": $map($ytdEven, function($v, $index) {
                        {
                          "variationsGroup": [
                            {
                              "variation": $string($v.comparison),
                              "direction": $v.variation_direction,
                              "unit_of_measure": $unitMeasure
                            },
                            {
                              "variation": $string($ytdOdd[$index].comparison),
                              "direction": $ytdOdd[$index].variation_direction,
                              "unit_of_measure": $unitMeasure
                            }
                          ]
                        }
                      })
                    }
                  }
                },
                "paddingTop": 20
              },
              "yearly": $count($yearEven) = 0 or $count($yearOdd) = 0
                ? { "empty": true }
                : {
                  "datasets": [
                    {
                      "type": "bar",
                      "data": $map($yearEven, function($v) { $v.ac }),
                      "backgroundColor": $map($yearEven, function($v) { $colorBars })
                    },
                    {
                      "type": "bar",
                      "data": $map($yearOdd, function($v) { $v.ac }),
                      "backgroundColor": $map($yearOdd, function($v) { $colorBarsComp })
                    }
                  ],
                  "labels": $yearEven.year,
                  "variation_caption": {
                    "title": "Comparison",
                    "subtitle": "Vs LY [ " & $yearMinYearly & " - " & $yearMaxYearly & " ]",
                    "variationsRows": {
                      "kpi": {
                        "data": $map($yearEven, function($v, $index) {
                          {
                            "variationsGroup": [
                              {
                                "variation": $string($v.comparison),
                                "direction": $v.variation_direction,
                                "unit_of_measure": $unitMeasure
                              },
                              {
                                "variation": $string($yearOdd[$index].comparison),
                                "direction": $yearOdd[$index].variation_direction,
                                "unit_of_measure": $unitMeasure
                              }
                            ]
                          }
                        })
                      }
                    }
                  },
                  "paddingTop": 20
                }
            }
          }
        )
        : (
          $yearMinQuarterly := $min($dsQuarterly.year);
          $yearMaxQuarterly := $max($dsQuarterly.year);
          $maxYearYtd := $max($dsYtd.year);
          $yearMinYearly := $min($dsYearly.year);
          $yearMaxYearly := $max($dsYearly.year);

          {
            "kpiData": {
              "quarterly": {
                "datasets": [
                  {
                    "type": "bar",
                    "data": $map($dsQuarterly, function($v) { $v.ac }),
                    "backgroundColor": $map($dsQuarterly, function($v) {
                      $v.year = $yearMaxQuarterly ? $colorBarsDark : $colorBars
                    })
                  }
                ],
                "labels": $map($dsQuarterly, function($v) { $v.quarter_year_formatted }),
                "variation_caption": {
                  "title": "Comparison",
                  "subtitle": "Vs LY [ " & $yearMinQuarterly & " - " & $yearMaxQuarterly & " ]",
                  "variationsRows": {
                    "kpi": {
                      "data": $map($dsQuarterly, function($v) {
                        {
                          "variationsGroup": [
                            {
                              "variation": $string($v.comparison),
                              "direction": $v.variation_direction,
                              "unit_of_measure": $unitMeasure
                            }
                          ]
                        }
                      })
                    }
                  }
                },
                "paddingTop": 20
              },
              "ytd": {
                "datasets": [
                  {
                    "type": "bar",
                    "data": $map($dsYtd, function($v) { $v.ac }),
                    "backgroundColor": $map($dsYtd, function($v) {
                      $v.year = $maxYearYtd ? $colorBarsDark : $colorBars
                    })
                  }
                ],
                "labels": $map($dsYtd, function($v) { $v.year }),
                "variation_caption": {
                  "title": "YTD",
                  "subtitle": "",
                  "variationsRows": {
                    "kpi": {
                      "data": $map($dsYtd, function($v) {
                        {
                          "variationsGroup": [
                            {
                              "variation": $string($v.comparison),
                              "direction": $v.variation_direction,
                              "unit_of_measure": $unitMeasure
                            }
                          ]
                        }
                      })
                    }
                  }
                },
                "paddingTop": 20
              },
              "yearly": $count($dsYearly) = 0
                ? { "empty": true }
                : {
                  "datasets": [
                    {
                      "type": "bar",
                      "data": $map($dsYearly, function($v) { $v.ac }),
                      "backgroundColor": $map($dsYearly, function($v) { $colorBars })
                    }
                  ],
                  "labels": $map($dsYearly, function($v) { $v.year }),
                  "variation_caption": {
                    "title": "Comparison",
                    "subtitle": "Vs LY [ " & $yearMinYearly & " - " & $yearMaxYearly & " ]",
                    "variationsRows": {
                      "kpi": {
                        "data": $map($dsYearly, function($v) {
                          {
                            "variationsGroup": [
                              {
                                "variation": $string($v.comparison),
                                "direction": $v.variation_direction,
                                "unit_of_measure": $unitMeasure
                              }
                            ]
                          }
                        })
                      }
                    }
                  },
                  "paddingTop": 20
                }
            }
          }
        )
    )
)
