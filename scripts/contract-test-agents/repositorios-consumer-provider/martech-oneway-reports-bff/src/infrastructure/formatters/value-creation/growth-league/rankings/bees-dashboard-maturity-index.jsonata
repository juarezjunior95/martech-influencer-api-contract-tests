/* *
 * 🏆 GROWTH LEAGUE RANKINGS BEES DASHBOARD MATURITY INDEX FORMATTER
 * 🎯 Component: BEES Dashboard Maturity Index Rankings
 * 📍 Used on: Growth League > Rankings > BEES Dashboard Maturity Index
 * 🔄 Input: value-creation_growth-league_rankings_bees-dashboard-maturity-index data
 * 📤 Output: Formatted BEES maturity index rankings data with flags */
(
  $data := $.datasources."value-creation_growth-league_rankings_bees-dashboard-maturity-index";

  $kpiConfig := {"tag": true, "unitMeasure": "%"};
  $emptyKpiConfig := {"tag": true };

  $fieldsFromGroupedColumnChildren := function($columnDefs, $groupHeaderName) {
    (
      $group := $filter($columnDefs, function($g) { $g.headerName = $groupHeaderName })[0];
      $map($group.children, function($col) { $col.field })
    )
  };

  $subtitleByField := $reduce($data, function($acc, $row) {
    (
      $fieldName := $row.kpi_variation;
      $lookup($acc, $fieldName) ? $acc : (
        $exists($row.score) and $row.score != null and $exists($row.dt_end)
          ? $merge([$acc, {($fieldName): $formatDateToMonth($row.dt_end)}])
          : $acc
      )
    )
  }, {});

  $headerComponentParamsForKpi := function($field) {
    (
      $s := $lookup($subtitleByField, $field);
      $s ? {"subtitle": $s} : {}
    )
  };

  $columnDefs := [
    {
      "headerName": "Leaderboard",
      "headerClass": ["ag-header-growth-league", "ag-cell-last-col-group-transparent", "ag-header-last-group-cell-white", "ag-header-first-group-cell-transparent"],
      "children": [
        {
          "headerName": "Rank",
          "field": "rank",
          "minWidth": 70,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-first-group-cell-transparent"],
          "config": {"borderGroupLeft": true, "radiusLeft": true, "groups": [{"final": 12}]}
        },
        {
          "headerName": "Country",
          "field": "country",
          "minWidth": 202,
          "headerClass": ["ag-cell-border-right-transparent", "ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent", "last-column-right-border", "ag-header-align-left"],
          "config": {"textAlign": "left", "radiusRight": true, "borderGroupRight": true, "groups": [{"final": 12}]}
        }
      ]
    },
    {
      "headerName": "BEES Dashboard",
      "headerClass": ["ag-header-growth-league", "ag-cell-last-col-group-transparent", "ag-header-last-group-cell-white"],
      "children": [
        {
          "headerName": "Total",
          "field": "overall_result",
          "headerComponentParams": $headerComponentParamsForKpi("overall_result"),
          "minWidth": 130,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent", "ag-header-first-group-cell-transparent"],
          "config": {"borderGroupLeft": true, "radiusLeft": true, "groups": [{"final": 12}], "borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Personalization",
          "field": "personalization",
          "headerComponentParams": $headerComponentParamsForKpi("personalization"),
          "minWidth": 135,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Category & Brands Balance Adherence",
          "field": "category_brands_balance_adherence",
          "headerComponentParams": $headerComponentParamsForKpi("category_brands_balance_adherence"),
          "minWidth": 170,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Incremental Conversion",
          "field": "incremental_conversion",
          "headerComponentParams": $headerComponentParamsForKpi("incremental_conversion"),
          "minWidth": 180,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Catalog Taxonomy Score",
          "field": "catalog_taxonomy_score",
          "headerComponentParams": $headerComponentParamsForKpi("catalog_taxonomy_score"),
          "minWidth": 176,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Digital Comms. Brilliant Basics",
          "field": "digital_comms_brilliant_basics",
          "headerComponentParams": $headerComponentParamsForKpi("digital_comms_brilliant_basics"),
          "minWidth": 177,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Bees Engaged POCs",
          "field": "bees_engaged_pocs",
          "headerComponentParams": $headerComponentParamsForKpi("bees_engaged_pocs"),
          "minWidth": 154,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Incremental Offers",
          "field": "investment_incremental_offers",
          "headerComponentParams": $headerComponentParamsForKpi("investment_incremental_offers"),
          "minWidth": 154,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Incremental Points Offer Completion",
          "field": "incremental_pocs",
          "headerComponentParams": $headerComponentParamsForKpi("incremental_pocs"),
          "minWidth": 160,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Effective Route",
          "field": "effective_route",
          "headerComponentParams": $headerComponentParamsForKpi("effective_route"),
          "minWidth": 135,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "POCs w/ Ideal Execution",
          "field": "pocs_ideal_execution_by_vision",
          "headerComponentParams": $headerComponentParamsForKpi("pocs_ideal_execution_by_vision"),
          "minWidth": 185,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "SKU Uptime - Focus Portfolio",
          "field": "sku_uptime_focus_portfolio",
          "headerComponentParams": $headerComponentParamsForKpi("sku_uptime_focus_portfolio"),
          "minWidth": 210,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Zero Failures",
          "field": "zero_failures",
          "headerComponentParams": $headerComponentParamsForKpi("zero_failures"),
          "minWidth": 149,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "NPS vs. Budget",
          "field": "nps_vs_budget",
          "headerComponentParams": $headerComponentParamsForKpi("nps_vs_budget"),
          "minWidth": 154,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Total Beer Volume vs Budget",
          "field": "total_beer_volume_vs_budget",
          "headerComponentParams": $headerComponentParamsForKpi("total_beer_volume_vs_budget"),
          "minWidth": 154,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Market Share",
          "field": "market_share_vs_ly",
          "headerComponentParams": $headerComponentParamsForKpi("market_share_vs_ly"),
          "minWidth": 130,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Total Distribution vs Budget",
          "field": "total_distribution_vs_budget",
          "headerComponentParams": $headerComponentParamsForKpi("total_distribution_vs_budget"),
          "minWidth": 180,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        },
        {
          "headerName": "Beer + BB Distribution",
          "field": "beer_and_bb_distribution_vs_budget",
          "headerComponentParams": $headerComponentParamsForKpi("beer_and_bb_distribution_vs_budget"),
          "minWidth": 195,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"radiusRight": true, "borderGroupRight": true, "groups": [{"final": 12}]}
        },
        {
          "headerName": "Monetization EBITDA vs Budget",
          "field": "monetization_ebitda_vs_budget",
          "headerComponentParams": $headerComponentParamsForKpi("monetization_ebitda_vs_budget"),
          "minWidth": 170,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": 0, "final": 12}]}
        }
      ]
    }
  ];

  $allKpiFields := $fieldsFromGroupedColumnChildren($columnDefs, "BEES Dashboard");

  $getCountryKey := function($row) {
    $exists($row.country_iso_code_3)
      ? $row.country_iso_code_3
      : ($type($row.country) = "string" ? $row.country : "")
  };

  $countries := $distinct($map($data, function($row) { $getCountryKey($row) }));
  $totalCountries := $count($countries);

  $pivotedData := $map($countries, function($countryName, $idx) {
    (
      $countryRows := $filter($data, function($row) { $getCountryKey($row) = $countryName });
      $firstRow := $countryRows[0];
      $isLast := $idx = $totalCountries - 1;

      $baseConfig := $isLast ? $merge([$kpiConfig, {"borderGroupBottom": true}]) : $kpiConfig;
      $emptyBaseConfig := $isLast ? $merge([$emptyKpiConfig, {"borderGroupBottom": true}]) : $emptyKpiConfig;
      
      $defaults := $reduce($allKpiFields, function($acc, $field) {
        $merge([$acc, {
          ($field): "-",
          ($field & "_config"): $emptyBaseConfig
        }])
      }, {});

      $kpiValues := $reduce($countryRows, function($acc, $row) {
        (
          $fieldName := $row.kpi_variation;
          $isKpiValid := $type($row.score) = "number";
          $merge([$acc, {
            ($fieldName): $isKpiValid ? $row.score : "-",
            ($fieldName & "_config"): $isKpiValid ? $baseConfig : $emptyBaseConfig
          }])
        )
      }, {});

      $merge([
        {
          "rank": $string($firstRow.country_ranking),
          "rank_config": $isLast
            ? {"Ranking": true, "textAlign": "center", "borderGroupBottom": true}
            : {"Ranking": true, "textAlign": "center"},
          "country": $countryName,
          "country_config": $isLast
            ? {
                "textAlign": "left",
                "leftImg": $exists($firstRow.country.imageIcon) ? $firstRow.country.imageIcon : $firstRow.country_images.imageIcon,
                "borderGroupBottom": true
              }
            : {
                "textAlign": "left",
                "leftImg": $exists($firstRow.country.imageIcon) ? $firstRow.country.imageIcon : $firstRow.country_images.imageIcon
              }
        },
        $defaults,
        $kpiValues
      ])
    )
  });

  {
    "columnDefs": $columnDefs,
    "rowData": [$pivotedData],
    "splits": [
      ["Leaderboard"],
      ["BEES Dashboard"]
    ]
  }
)
