/**
 * 🔢 CORES OVERTIME PERFORMANCE FORMATTER
 * 🎯 Component: BigNumberCards
 * 📍 Used on: Value Creation > Performance Tool > Drill Down > Finance > Cores > Overtime Performance
 * 🔄 Input: value-creation_performance-tool_drill-down_finance_cores_overtime-performance
 * 📤 Output: BigNumbersSectionData[] (header + data: vs LY + vs BU per section)
 * 🔧 Empty state: 3 cards (YTD, L3M, MTD) with header and data: []
 */

(
  $datasourceName := "value-creation_performance-tool_drill-down_finance_cores_overtime-performance";
  $data := $lookup(datasources, $datasourceName);

  $formatValue := function($value) {
    $exists($value) and $type($value) = "number" ?
      $formatNumber($value, '#,##0.0')
      : "-"
  };

  $getPeriodLabel := function($period) {
    (
      $periodType := $period.period;
      $refresh := $period.refreshMonthLabel;
      $periodType = "YTD" ? "CORES YTD" :
      $periodType = "L3M" ? "CORES L3M" :
      $periodType = "MTD" ? "CORES " & $refresh :
      "CORES " & $periodType
    )
  };

  $formatMeasure := function($measure) {
    $exists($measure) and $measure != "" ? "[ " & $measure & " ]" : ""
  };

  $getPeriodOrder := function($periodType) {
    $periodType = "YTD" ? 1 :
    $periodType = "L3M" ? 2 :
    $periodType = "MTD" ? 3 :
    4
  };

  $hasValidData := function($period) {
    $exists($period) and
    $exists($period.ac) and
    $type($period.ac) = "number"
  };

  $buildPeriodData := function($period) {
    $hasValidData($period) ? [
      {
        "bigNumber": {
          "value": $formatValue($period.ac_vs_ly),
          "measure": $period.comp_unit_of_measure,
          "trend": $getTrend($period.ac_vs_ly, $period.variationDirectionVsLy)
        },
        "secondaryInfo": {
          "value": $formatValue($period.ac),
          "label": $formatMeasure($period.unit_of_measure)
        },
        "comparison": {
          "label": "vs",
          "value": "LY"
        }
      },
      {
        "bigNumber": {
          "value": $formatValue($period.ac_vs_bu),
          "measure": $period.comp_unit_of_measure,
          "trend": $getTrend($period.ac_vs_bu, $period.variationDirectionVsBu)
        },
        "comparison": {
          "label": "vs",
          "value": "BU"
        }
      }
    ] : []
  };

  $expectedPeriods := ["YTD", "L3M", "MTD"];
  $map($expectedPeriods, function($periodType) {
    (
      $period := $filter($data, function($item) { $item.period = $periodType })[0];
      {
        "header": {
          "title": $exists($period) ? $getPeriodLabel($period) : "CORES " & $periodType,
          "measure": $exists($period) ? $formatMeasure($period.unit_of_measure) : "[ $Mio ]"
        },
        "data": $buildPeriodData($period)
      }
    )
  })
)
