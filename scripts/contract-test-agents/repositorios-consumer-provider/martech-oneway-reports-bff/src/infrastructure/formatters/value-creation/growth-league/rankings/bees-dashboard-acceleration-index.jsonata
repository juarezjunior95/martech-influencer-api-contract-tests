/* *
 * 🏆 GROWTH LEAGUE RANKINGS BEES DASHBOARD ACCELERATION INDEX FORMATTER
 * 🎯 Component: BEES Dashboard acceleration Index Rankings
 * 📍 Used on: Growth League > Rankings > BEES Dashboard acceleration Index
 * 🔄 Input: value-creation_growth-league_rankings_bees-dashboard-acceleration-index data
 * 📤 Output: Formatted BEES acceleration index rankings data with flags */
(
  $data := $.datasources."value-creation_growth-league_rankings_bees-dashboard-acceleration-index";

  $kpiConfig := {"tag": true, "unitMeasure": "%"};
  $emptyKpiConfig := {"tag": true};

  $fieldsFromGroupedColumnChildren := function($columnDefs, $groupHeaderName) {
    (
      $group := $filter($columnDefs, function($g) { $g.headerName = $groupHeaderName })[0];
      $map($group.children, function($col) { $col.field })
    )
  };

  $subtitleByField := $reduce($data, function($acc, $row) {
    (
      $fieldName := $row.kpi_variation;
      $lookup($acc, $fieldName) ? $acc : (
        $exists($row.score) and $row.score != null and $exists($row.dt_end)
          ? $merge([$acc, {($fieldName): $formatDateToMonth($row.dt_end)}])
          : $acc
      )
    )
  }, {});

  $headerComponentParamsForKpi := function($field) {
    (
      $s := $lookup($subtitleByField, $field);
      $s ? {"subtitle": $s} : {}
    )
  };

  $rawColumnDefs := [
    {
      "headerName": "Leaderboard",
      "headerClass": ["ag-header-growth-league", "ag-cell-last-col-group-transparent", "ag-header-last-group-cell-white", "ag-header-first-group-cell-transparent"],
      "children": [
        {
          "headerName": "Rank",
          "field": "rank",
          "minWidth": 70,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-first-group-cell-transparent"],
          "config": {"borderGroupLeft": true, "radiusLeft": true, "groups": [{"final": "last"}]}
        },
        {
          "headerName": "Country",
          "field": "country",
          "minWidth": 232,
          "headerClass": ["ag-cell-border-right-transparent", "ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent", "last-column-right-border", "ag-header-align-left"],
          "config": {"textAlign": "left", "radiusRight": true, "borderGroupRight": true, "groups": [{"final": "last"}]}
        }
      ]
    },
    {
      "headerName": "BEES Dashboard",
      "headerClass": ["ag-header-growth-league", "ag-header-last-group-cell-white"],
      "children": [
        {
          "headerName": "Total",
          "field": "overall_result",
          "headerComponentParams": $headerComponentParamsForKpi("overall_result"),
          "minWidth": 136,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent", "ag-header-first-group-cell-transparent"],
          "config": {"borderGroupLeft": true, "radiusLeft": true, "borderGroup": true, "groups": [{"final": "last"}], "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "BEES NR",
          "field": "bees_net_revenue",
          "headerComponentParams": $headerComponentParamsForKpi("bees_net_revenue"),
          "minWidth": 127,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "BEES Buyers",
          "field": "bees_buyers",
          "headerComponentParams": $headerComponentParamsForKpi("bees_buyers"),
          "minWidth": 123,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Catalog Taxonomy Score",
          "field": "catalog_taxonomy_score",
          "headerComponentParams": $headerComponentParamsForKpi("catalog_taxonomy_score"),
          "minWidth": 144,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Digital Comms Brilliant Basics",
          "field": "digital_comms_brilliant_basics_light",
          "headerComponentParams": $headerComponentParamsForKpi("digital_comms_brilliant_basics_light"),
          "minWidth": 191,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "SKUs influenced ",
          "field": "skus_influenced",
          "headerComponentParams": $headerComponentParamsForKpi("skus_influenced"),
          "minWidth": 144,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "BEES NPS",
          "field": "bees_nps",
          "headerComponentParams": $headerComponentParamsForKpi("bees_nps"),
          "minWidth": 116,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Bees Engaged POCs",
          "field": "bees_engaged_points_offer_completion",
          "headerComponentParams": $headerComponentParamsForKpi("bees_engaged_points_offer_completion"),
          "minWidth": 165,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Points Offers Completion",
          "field": "points_offers_completion",
          "headerComponentParams": $headerComponentParamsForKpi("points_offers_completion"),
          "minWidth": 186,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Incremental Convertion",
          "field": "incremental_convertion",
          "headerComponentParams": $headerComponentParamsForKpi("incremental_convertion"),
          "minWidth": 175,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Commercial Impact",
          "field": "commercial_impact",
          "headerComponentParams": $headerComponentParamsForKpi("commercial_impact"),
          "minWidth": 165,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Distribution",
          "field": "distribution",
          "headerComponentParams": $headerComponentParamsForKpi("distribution"),
          "minWidth": 120,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "FrontLine/Cont. Health",
          "field": "frontline_cont_health",
          "headerComponentParams": $headerComponentParamsForKpi("frontline_cont_health"),
          "minWidth": 175,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"borderGroup": true, "intermediateColGroup": [{"initial": "first", "final": "last"}]}
        },
        {
          "headerName": "Scale",
          "field": "scale",
          "headerComponentParams": $headerComponentParamsForKpi("scale"),
          "minWidth": 100,
          "headerClass": ["ag-header-last-group-cell-white", "ag-header-last-group-cell-transparent"],
          "config": {"radiusRight": true, "borderGroupRight": true, "groups": [{"final": "last"}]}
        }
      ]
    }
  ];

  $hasKpi := function($field) {
    $count($filter($data, function($r) {
      $r.kpi_variation = $field and $type($r.score) = "number" and $r.score != null
    })) > 0
  };

  $optionalFieldsVisibility := {
    "future_foundations": $hasKpi("future_foundations"),
    "commercial_impact": $hasKpi("commercial_impact"),
    "distribution": $hasKpi("distribution"),
    "frontline_cont_health": $hasKpi("frontline_cont_health"),
    "scale": $hasKpi("scale")
  };

  $columnDefs := $map($rawColumnDefs, function($group) {
    (
      $isBees := ($group.headerName = "BEES Dashboard");
      $isBees
        ? $merge([
            $group,
            {
              "children": $filter($group.children, function($col) {
                (
                  $v := $lookup($optionalFieldsVisibility, $col.field);
                  $exists($v) ? $v : true
                )
              })
            }
          ])
        : $group
    )
  });

  $allKpiFields := $fieldsFromGroupedColumnChildren($columnDefs, "BEES Dashboard");

  $getCountryKey := function($row) {
    $exists($row.country_iso_code_3)
      ? $row.country_iso_code_3
      : ($type($row.country) = "string" ? $row.country : "")
  };

  $countries := $distinct($map($data, function($row) { $getCountryKey($row) }));
  $totalCountries := $count($countries);

  $pivotedData := $map($countries, function($countryName, $idx) {
    (
      $countryRows := $filter($data, function($row) { $getCountryKey($row) = $countryName });
      $firstRow := $countryRows[0];
      $isLast := $idx = $totalCountries - 1;

      $baseConfig := $isLast ? $merge([$kpiConfig, {"borderGroupBottom": true}]) : $kpiConfig;
      $emptyBaseConfig := $isLast ? $merge([$emptyKpiConfig, {"borderGroupBottom": true}]) : $emptyKpiConfig;
      
      $defaults := $reduce($allKpiFields, function($acc, $field) {
        $merge([$acc, {
          ($field): "-",
          ($field & "_config"): $emptyBaseConfig
        }])
      }, {});

      $kpiValues := $reduce($countryRows, function($acc, $row) {
        (
          $fieldName := $row.kpi_variation;
          $isKpiValid := $type($row.score) = "number" and $row.score != null;
          $merge([$acc, {
            ($fieldName): $isKpiValid ? $row.score : "-",
            ($fieldName & "_config"): $isKpiValid ? $baseConfig : $emptyBaseConfig
          }])
        )
      }, {});

      $merge([
        {
          "rank": $string($firstRow.country_ranking),
          "rank_config": $isLast
            ? {"Ranking": true, "textAlign": "center", "borderGroupBottom": true}
            : {"Ranking": true, "textAlign": "center"},
          "country": $countryName,
          "country_config": $isLast
            ? {
                "textAlign": "left",
                "leftImg": $exists($firstRow.country.imageIcon) ? $firstRow.country.imageIcon : $firstRow.country_images.imageIcon,
                "borderGroupBottom": true
              }
            : {
                "textAlign": "left",
                "leftImg": $exists($firstRow.country.imageIcon) ? $firstRow.country.imageIcon : $firstRow.country_images.imageIcon
              }
        },
        $defaults,
        $kpiValues
      ])
    )
  });

  {
    "columnDefs": $columnDefs,
    "rowData": [$pivotedData],
    "splits": [
      ["Leaderboard"],
      ["BEES Dashboard"]
    ]
  }
)
