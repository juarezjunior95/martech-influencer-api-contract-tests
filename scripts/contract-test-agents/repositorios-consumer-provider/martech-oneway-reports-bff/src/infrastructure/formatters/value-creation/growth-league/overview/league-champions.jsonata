/* *
 * 🏆 GROWTH LEAGUE OVERVIEW LEAGUE CHAMPIONS FORMATTER
 * 🎯 Component: League Champions
 * 📍 Used on: Growth League > Overview > League Champions
 * 🔄 Input: value-creation_growth-league_overview_league-champions data
 * 📤 Output: Formatted league champions data grouped by league with flags */
(
  $data := $.datasources."value-creation_growth-league_overview_league-champions";

  $leagues := $distinct($data.league);

  $leagueChampions := $map($leagues, function($league) {
    {
      "label": $replace($lowercase($league), " ", "-"),
      "rank": $map($filter($data, function($item) { $item.league = $league }), function($item) {
        {
          "countryName": $item.country_iso_code_3,
          "position": $string($item.ranking),
          "value": $number($item.score),
          "flag": $item.country.imageWaving,
          "measure": "%"
        }
      })
    }
  });

  {
    "leagueChampions": $leagueChampions
  }
)
