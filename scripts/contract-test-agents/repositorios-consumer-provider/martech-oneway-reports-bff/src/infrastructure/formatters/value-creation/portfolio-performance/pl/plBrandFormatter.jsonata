(
  /* ============================================================
     DATA SOURCES & CONFIG
     ============================================================ */
  $volumeGrowth := $map(
    datasources.`value-creation_portfolio-performance_pl_brand_volume`,
    function($v) {
      (
        $dt := $v.dt_ini;
        $year := $substring($dt, 0, 4);
        $yearNum := $number($year);
        $merge([$v, { 
          "label_year_formatted": $year & " " & "AC", 
          "label_year_formatted_ly": ($yearNum - 1) & " " & "AC" 
        }])
      )
    }
  );
  $growthContribution := datasources.`value-creation_portfolio-performance_pl_brand_growth-contribution`;
  $output := datasources.`value-creation_portfolio-performance_pl_brand_output`;

  $config := {
    "kpi_name_labels": {
      "volume_growth_contr": {
        "label": "Growth Contribution",
        "subtitle": ""
      },
      "volume": {
        "label": "Vol",
        "subtitle": "[k hl]"
      },
      "nr": {
        "label": "NR",
        "subtitle": "[$Mio]"
      },
      "nr_per_hl": {
        "label": "NR/hl",
        "subtitle": "[$/hl]"
      },
      "sm": {
        "label": "S&M",
        "subtitle": "[$Mio]",
        "compUnitOfMeasure": "pp",
        "invertDirection": true
      },
      "sm_of_maco": {
        "label": "S&M % MACO",
        "subtitle": "",
        "unitOfMeasure": "%",
        "compUnitOfMeasure": "pp",
        "invertDirection": true
      },
      "maco_per_hl": {
        "label": "MACO/hl",
        "subtitle": "[$/hl]"
      },
      "cores_per_hl": {
        "label": "CORES/hl",
        "subtitle": "[$/hl]"
      },
      "p4w": {
        "label": "Beer Participation",
        "unitOfMeasure": "%",
        "usePeriodSubtitle": true
      },
      "power": {
        "label": "Brand Power",
        "unitOfMeasure": "%",
        "usePeriodSubtitle": true
      },
      "market_share": {
        "label": "Market Share"
      }
    },
    "legend": {
      "current_year_color": "#D1A33C",
      "last_year_color": "#ABBFCB"
    },
    "variation_color": {
      "up": "#49764B",
      "down": "#A20A0A"
    }
  };
  /* ============================================================
     UTILITY FUNCTIONS (safeNumber from global helpers)
     ============================================================ */
  $formatQuarter := function($dateStr) {(
    $exists($dateStr) and $dateStr != "" ? (
      $month := $number($substring($dateStr, 5, 2));
      $quarter := $ceil($month / 3);
      $year := $substring($dateStr, 2, 2);
      "Q" & $string($quarter) & "'" & $year
    ) : undefined
  )};

  $getBarChartColor := function($direction) {
    $lookup($config.variation_color, $direction) ?? ""
  };

  $isValidNumber := function($val) { $type($val) = "number" };
  $formatValue := function($val) { 
    ($not($isValidNumber($val)) or $val = null or $val = "") ? "-" : $val 
  };

  $invertVsLyDirection := function($direction) {
    $direction = "up" ? "down" : "up"
  };

  $getSubtitleByValue := function($val) {
    (
      $subtitleConfig := $lookup($config.kpi_name_labels, $val); 
      $subtitleConfig ? ($subtitleConfig.subtitle ?? null) : null;
    )
  };

  $normalizeId := function($segment, $brand) {
    (
      $seg := $lowercase($segment);
      $br := $lowercase($replace($brand, "[^A-Za-z0-9]", "_"));
      ($seg = "tt" or $seg = "n/a") ? "tt_market_beer_adj" : $seg & "_" & $br
    )
  };

  $filterBySegment := function($data, $segment) {
    $filter($data, function($item) { $lowercase($item.segment) = $lowercase($segment) })
  };

  $filterByKpi := function($data, $kpi) {
    $filter($data, function($item) { $item.kpi_name = $kpi })
  };

  $getDateLabel := function($kpiData, $kpi) {
    (
      $kpiLabelConfig := $lookup($config.kpi_name_labels, $kpiData.kpi_name);
      $kpiLabelConfig.usePeriodSubtitle ?
        (
          $formatQuarter($kpiData.dt_end);
        )
        :
        (
          $exists($kpiData.refreshMonthLabel) ? 
            $kpiData.refreshMonthLabel
            : undefined;
        )
    )
  };

  $getKpiSubtitle := function($data, $kpi) {
    (
      $kpiData := $data[kpi_name = $kpi][0];
      $subtitleConfig := $getSubtitleByValue($kpiData.kpi_name);
      
      $subtitleConfig = null ?
        $getDateLabel($kpiData, $kpi)
        : $subtitleConfig;
    )
  };

  $getDistinctKpis := function($data) {
    $distinct($map($filter($data, function($cell) { $cell.kpi_name != "" }), function($entry) { $entry.kpi_name }))
  };

  $formatKpiValue := function($val) {
    (
       $lookup($config.kpi_name_labels, $val).label ?? $val;
    )
  };

  /* ============================================================
     CHART CONFIGURATION
     ============================================================ */
  $valuePairs := $map(
    $volumeGrowth, 
    function($v) { 
      [$safeNumber($v.ac), $safeNumber($v.ac_vs_ly), 0, 100]
    }
  );
  $flatValues := $reduce($valuePairs, $append);
  $validNumbers := $filter($flatValues, $isValidNumber);
  $minValue := $count($validNumbers) > 0 ? $min($validNumbers) : 0;
  $maxValue := $count($validNumbers) > 0 ? $max($validNumbers) : 100;

  /* ============================================================
     HEADER HELPERS
     ============================================================ */
  $groupedBrands := function($seg, $emptyTitle) {
    [
      $map(
        $filterBySegment($volumeGrowth, $seg),
        function($v) { 
          { 
            "title": $emptyTitle ? "" : $v.raw_brand, 
            "id": $normalizeId($v.segment, $v.raw_brand) 
          } 
        }
      )
    ]
  };

  $filterJoin := function($seg) {
    $join(
      $map($filterBySegment($volumeGrowth, $seg), function($v) { $normalizeId($v.segment, $v.raw_brand) }),
      ", "
    )
  };
  /* ============================================================
     ROW BUILDERS
     ============================================================ */
  $buildVsLyRow := function($data, $kpi, $unitMeasure) {
    $merge([
      {
        "profit_loss": { "value": "vs LY" }
      },
      $map(
        $filterByKpi($data, $kpi),
        function($v) {
          (
            $formattedValue := $formatValue($v.ac_vs_ly);
            $kpiConfig := $lookup($config.kpi_name_labels, $v.kpi_name);
            $configUnit := $kpiConfig.compUnitOfMeasure;
            $compUnitOfMeasure := 
              $configUnit ?? $unitMeasure;
            $variationDirection := $kpiConfig.invertDirection = true ?
              $invertVsLyDirection($v.variationDirectionVsLy) : $v.variationDirectionVsLy;
            {
              ($normalizeId($v.segment, $v.raw_brand)): {
                "value": $formattedValue,
                "unitMeasure": $formattedValue = "-" ? undefined : $compUnitOfMeasure,
                "variationDirection": $formattedValue = "-" 
                  ? "" 
                    : $variationDirection
              }
            }
          )
        }
      )
    ])
  };

  $buildKpiRowWithUnit := function($data, $kpi, $getSubtitleFn, $specialKpiUnit, $subtitleDataSource) {
    (
      $subtitleKpi := $subtitleDataSource ? $getKpiSubtitle($subtitleDataSource, $kpi) : $getKpiSubtitle($data, $kpi);
      $kpiValue := $getKpiSubtitle($data, $kpi);
      $merge([
        {
          "profit_loss": {
            "value": $formatKpiValue($kpi),
            "subtitle": $getKpiSubtitle($data, $kpi)
          }
        },
        $map(
          $filterByKpi($data, $kpi),
          function($v) {
            (
              $formattedValue := $formatValue($v.ac);
              $configUnit := $lookup($config.kpi_name_labels, $v.kpi_name).unitOfMeasure;
              $unitOfMeasure := 
                $configUnit ?? $unitMeasure;
              {
                ($normalizeId($v.segment, $v.raw_brand)): {
                  "value": $formattedValue,
                  "unitMeasure": $formattedValue != "-"
                    ? (
                        $specialKpiUnit and $kpi = $specialKpiUnit
                        ? "%" : $unitOfMeasure
                      )
                    : undefined
                }
              }
            )
          }
        )
      ])
    )
  };

  $buildOutputHeaderRow := function() {
    $merge([
      {
        "profit_loss": { "value": "Output" }
      },
      $map(
        $volumeGrowth,
        function($v) {
          {
            ($normalizeId($v.segment, $v.raw_brand)): { "value": "" }
          }
        }
      )
    ])
  };

  /* ============================================================
     OUTPUT STRUCTURE
     ============================================================ */
  $count($volumeGrowth) = 0
    ? { "empty": true }
    : {
      "header": $filter(
        [
          {
            "title": "KPI",
            "id": "kpi",
            "children": [{ 
              "title": "Profit and Loss", 
              "subtitle": $growthContribution[kpi_name = "nr"][0].refreshMonthLabel, 
              "id": "profit_loss" 
            }]
          },
          {
            "title": "TT Market",
            "children": [
              $map(
                $filterBySegment($volumeGrowth, "tt"),
                function($v) { { "title": "Beer + ADJ", "id": "tt_market_beer_adj" } }
              )
            ]
          },
          { "title": "Megabrands", "children": $groupedBrands("megabrands") },
          { "title": "Expansion", "children": $groupedBrands("expansion") },
          { "title": "Sustain", "children": $groupedBrands("sustain") },
          { "title": "Tail", "children": $groupedBrands("tail", true) }
        ],
        function($v) { $count($v.children) > 0 }
      ),
      /* =====================  FILTER OPTIONS ======================= */
      "filtersOptions": [
        {
          "group": "Portfolio",
          "values": $filter(
            [
              { "label": "Megabrands", "value": $filterJoin("megabrands") },
              { "label": "Expansion", "value": $filterJoin("expansion") },
              { "label": "Sustain", "value": $filterJoin("sustain") },
              { "label": "Tail", "value": $filterJoin("tail") }
            ],
            function($v) { $v.value != "" }
          )
        }
      ],
      /* ===================== ROWS ======================= */
      "rows": [
        [
          /* ROW 1: Volume Growth */
          $merge([
            {
              "profit_loss": {
                "chartLegend": {
                  "title": "Volume Growth",
                  "values": [
                    { "color": $config.legend.last_year_color, "label": $volumeGrowth[0].label_year_formatted_ly },
                    { "color": $config.legend.current_year_color, "label": $volumeGrowth[0].label_year_formatted }
                  ]
                }
              }
            },
            $map(
              $volumeGrowth,
              function($v) {
                {
                  ($normalizeId($v.segment, $v.raw_brand)): {
                    "chartData": {
                      "data": [$v.ac_vs_ly, $v.ac],
                      "backgroundColor": ["#ABBFCB", "#D1A33C"],
                      "variationColor": [
                        $getBarChartColor($v.variationDirectionVsLy), 
                        $getBarChartColor($v.variationDirectionAc)
                      ],
                      "max": $maxValue,
                      "min": $minValue,
                      "labels": [$v.label_year_formatted_ly, $v.label_year_formatted],
                      "variationMeasure": "%",
                      "variationDirection": [$v.variationDirectionVsLy, $v.variationDirectionAc]
                    }
                  }
                }
              }
            )
          ]),
          /* ROW 2: KPIs growth_contribution */
          $reduce(
            $getDistinctKpis($growthContribution),
            function($acc, $kpi) {
              $append(
                $append($acc, $buildKpiRowWithUnit($growthContribution, $kpi, $getSubtitleByValue, "volume_growth_contr")),
                ($kpi != "volume_growth_contr" ? [$buildVsLyRow($growthContribution, $kpi, "%")] : [])
              )
            },
            []
          )
        ],
        [
          /* ROW 3: OUTPUT */
          $append(
            [$buildOutputHeaderRow()],
            $reduce(
              $getDistinctKpis($output),
              function($acc, $kpi) {
                $append(
                  $append($acc, $buildKpiRowWithUnit($output, $kpi, $getSubtitleByValue, "market_share", $growthContribution)),
                  [$buildVsLyRow($output, $kpi, "pp")]
                )
              },
              []
            )
          )
        ]
      ]
    }
)