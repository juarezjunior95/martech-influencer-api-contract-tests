/* *
 * 📈 SALES PERFORMANCE FORMATTER
 * 🎯 Component: Area Chart
 * 📍 Used on: Example > Sales > Performance
 * 🔄 Input: sales datasource
 * 📤 Output: Sales performance data with calculations */
(
  $datasource_sales := $lookup($$.datasources, "sales");
  $performance_data := $datasource_sales.(
    {
      "product": product,
      "totalSales": sales,
      "totalUnits": units,
      "averagePrice": $round(sales / units, 2),
      "country": country,
      "category": category
    }
  );
  $performance_data
)
