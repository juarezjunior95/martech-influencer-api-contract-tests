/* *
 * 💰 REVENUE SUMMARY FORMATTER
 * 🎯 Component: Big Number
 * 📍 Used on: Example > Overview > Revenue Summary
 * 🔄 Input: revenue datasource
 * 📤 Output: Total revenue value */
(
  $datasource_revenue := $lookup($$.datasources, "revenue");
  $total_revenue := $sum($datasource_revenue.revenue);
  $total_revenue
)
