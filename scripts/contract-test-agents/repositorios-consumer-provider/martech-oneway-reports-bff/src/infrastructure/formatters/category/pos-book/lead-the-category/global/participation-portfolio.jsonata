/**
 * 🔢 PARTICIPATION PORTFOLIO FORMATTER
 * 🎯 Component: Table
 * 📍 Used on: Category > POS Book > Lead the Category > Global > Participation Portfolio
 * 🔄 Input: category_pos-book_lead-the-category_global_participation-portfolio data
 * 📤 Output: Portfolio participation table with header and rows grouped by maturity
 * 🔧 Config: Fixed types (Total ABI, Megabrands, Expansion, Sustain, Tail)
 */

(
  $dsKey := $keys(datasources)[0];
  $data := $lookup(datasources, $dsKey);
  $isEmpty := $count($data) = 0;

  $chartUnitMeasure := "%";
  $variationMeasure := "pp";

  $typeIds := ["total_abi", "megabrands", "expansion", "sustain", "tail"];
  $typeTitles := ["Total ABI", "Megabrands", "Expansion", "Sustain", "Tail"];
  $typeKeys := ["Total ABI", "Megabrands", "Expansion", "Sustain", "Tail"];

  $colorDict := {
    "total_abi": "#EEC879",
    "megabrands": "#F0DF78",
    "expansion": "#F6B7D0",
    "sustain": "#A1CFF4",
    "tail": "#B5BDF7"
  };

  $getColor := function($typeId) {
    $lookup($colorDict, $typeId)
  };

  $toTypeId := function($typeName) {
    $lowercase($replace($typeName, " ", "_"))
  };

  $getChartScaleMax := function($typeName) {
    (
      $typeData := $filter($data, function($item) { $item.type = $typeName });
      $acValues := $map($typeData, function($item) { 
        $type($item.ac) = "number" ? $item.ac : 0 
      });
      $validValues := $filter($acValues, function($val) { $type($val) = "number" });
      $count($validValues) > 0 ? $max($validValues) : 100
    )
  };

  $chartScaleMaxTotalAbi := $getChartScaleMax("Total ABI");
  $chartScaleMaxMegabrands := $getChartScaleMax("Megabrands");
  $chartScaleMaxExpansion := $getChartScaleMax("Expansion");
  $chartScaleMaxSustain := $getChartScaleMax("Sustain");
  $chartScaleMaxTail := $getChartScaleMax("Tail");

  $emptyTypeData := {
    "chartData": {
      "data": [],
      "backgroundColor": [],
      "chartUnitMeasure": $chartUnitMeasure
    },
    "variationMeasure": ""
  };

  $buildTypeData := function($item, $typeId, $chartScaleMax) {
    $item ? {
      "chartData": {
        "data": [$formatValue($item.ac)],
        "backgroundColor": [$getColor($typeId)],
        "chartUnitMeasure": $chartUnitMeasure
      },
      "variation": $formatValue($item.ac_vs_ly),
      "variationMeasure": $variationMeasure,
      "chartScaleMax": $chartScaleMax
    } : $emptyTypeData
  };

  $maturityOrder := ["N/A", "M3", "M2", "M1"];
  $distinctMaturities := $distinct($data.maturity);
  
  $sortedMaturities := $filter($maturityOrder, function($maturity) {
    $maturity in $distinctMaturities
  });

  $buildCountryRow := function($countryRowData, $maturityLabel) {
    (
      $countryCode := $countryRowData[0].country_iso_code_3;
      $displayCountry := $countryCode = "Global" ? "Global" : $countryCode;
      
      $totalAbiItem := $filter($countryRowData, function($item) { $item.type = "Total ABI" })[0];
      $megabrandsItem := $filter($countryRowData, function($item) { $item.type = "Megabrands" })[0];
      $expansionItem := $filter($countryRowData, function($item) { $item.type = "Expansion" })[0];
      $sustainItem := $filter($countryRowData, function($item) { $item.type = "Sustain" })[0];
      $tailItem := $filter($countryRowData, function($item) { $item.type = "Tail" })[0];
      
      {
        "label": { "value": $maturityLabel },
        "country": { "value": $displayCountry },
        "total_abi": $buildTypeData($totalAbiItem, "total_abi", $chartScaleMaxTotalAbi),
        "megabrands": $buildTypeData($megabrandsItem, "megabrands", $chartScaleMaxMegabrands),
        "expansion": $buildTypeData($expansionItem, "expansion", $chartScaleMaxExpansion),
        "sustain": $buildTypeData($sustainItem, "sustain", $chartScaleMaxSustain),
        "tail": $buildTypeData($tailItem, "tail", $chartScaleMaxTail)
      }
    )
  };

  $buildRows := function() {
    $map($sortedMaturities, function($maturity) {
      (
        $maturityData := $filter($data, function($item) { $item.maturity = $maturity });
        $distinctCountries := $distinct($maturityData.country_iso_code_3);
        $maturityLabel := $maturity = "N/A" ? " " : $maturity;
        
        $map($distinctCountries, function($country) {
          (
            $countryRowData := $filter($maturityData, function($item) { $item.country_iso_code_3 = $country });
            $buildCountryRow($countryRowData, $maturityLabel)
          )
        })
      )
    })
  };

  $labelHeader := {
    "title": "Label",
    "children": [
      { "title": "Label", "id": "label" },
      { "title": "Country", "id": "country" }
    ]
  };

  $typeHeaders := $map($typeIds, function($typeId, $idx) {
    {
      "title": $typeTitles[$idx],
      "id": $typeId
    }
  });

  $header := $append([$labelHeader], $typeHeaders);

  $isEmpty
    ? { "empty": true }
    : {
        "rows": $buildRows(),
        "header": $header
      }
)
