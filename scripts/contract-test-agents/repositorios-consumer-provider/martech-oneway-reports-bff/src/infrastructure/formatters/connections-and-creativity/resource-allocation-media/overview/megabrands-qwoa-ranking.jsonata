(
  /**
   * 🎯 Component: Megabrands QWOA Ranking Chart (by segment or country, with guideline)
   * 📍 Used on: Resource Allocation Media > Overview
   * 🔄 Input: connections-and-creativity_resource-allocation-media_overview_unified-ranking
   * 📤 Output: megabrands { owr_resource-allocation_overview_ranking-chart_megabrands: { datasets, labels, icons, variation_caption, horizontalDashedLine } }
   * 🔧 Config: chart_key, segments, country_map, unit_of_measure, datasets, variation_caption
   */

  /* ─── Config ─── */
  $config := {
    "chart_key": "owr_resource-allocation_overview_ranking-chart_megabrands",
    "unit_of_measure": "%",
    "datasets": {
      "label": "Megabrands",  
      "background_color": "#F0D59E"
    },
    "variation_caption": {
      "title": "Guideline",
      "subtitle": "vs AC [ YTD ]"
    },
    "horizontal_line_default": 35,
    "horizontal_line_fallback": 45,
    "colors": {
      "variation_up": "#00810d",
      "variation_down": "#a30a0a"
    }
  };

  $segments := $getSegmentColors();
  $countryMap := $getCountryMap();
  $datasources := $exists(components) and $count(components) > 0
    ? components[0].data.datasources
    : ($exists(datasources) ? datasources : {});
  $dsKey := $keys($datasources)[0];
  $ds := $lookup($datasources, $dsKey);
  $rawData := $exists($ds.data) ? $ds.data : ($exists($ds) and $type($ds) = "array" ? $ds : []);
  $filteredData := $count($rawData) > 0
    ? $rawData[level_2 = "qwoa"]
    : [];
  $isEmpty := $count($filteredData) = 0;
  
  $isCountryView := $count($filteredData[raw_brand = "N/A"]) > 0;
  $entry := $isEmpty
    ? []
    : (
      $isCountryView
        ? $sort($filteredData, function($a, $b) { $a.ac < $b.ac })
        : (
          $segmentOrder := $keys($segments);
          $reduce($segmentOrder, function($acc, $segment) {(
            $filtered := $filteredData[segment = $segment];
            $sortedSegment := $count($filtered) > 0
              ? $sort($filtered, function($a, $b) { $a.ac < $b.ac })
              : [];
            $append($acc, $sortedSegment)
          )}, [])
        )
    );
  $entrySorted := $entry;
  $dataValues := $ensureArray($entrySorted.ac);
  $maxValue := $max($dataValues);
  $suggestedMax := $maxValue >= 100 ? 100 : ($isCountryView ? $maxValue : $ceil($maxValue));
  $megabrandsCount := $count($entrySorted[segment = "Megabrands"]);
  $firstLineValue := $config.horizontal_line_fallback;
  $secondLineValue := $config.horizontal_line_default;
  $horizontalDashedLine := $isEmpty
    ? []
    : (
      $megabrandsCount > 0
        ? [
            { "value": 45, "xEnd": $megabrandsCount },
            { "value": 35 }
          ]
        : [{ "value": 60}]
    );

  {
    "megabrands": $isEmpty
      ? { "empty": true }
      : {
          ($config.chart_key): {
            "datasets": [
              {
                "type": "bar",
                "label": $config.datasets.label,
                "data": $dataValues,
                "backgroundColor": [$config.datasets.background_color],
                "baseChartColor": $isCountryView
                  ? null
                  : $ensureArray($entrySorted.($lookup($segments, segment) ?: $segments.Megabrands)),
                "formattedData": $ensureArray(
                  $map($entrySorted, function($row) {
                    $row.ac != "-" and $row.ac != ""
                      ? ($isCountryView
                          ? $formatNumber($safeNumber($row.ac), "#0.0") & $config.unit_of_measure
                          : $formatNumber($safeNumber($row.ac), "#0"))
                      : ""
                  })
                )
              }
            ],
            "formattedData": [[$map($entrySorted, function($row) {
              $row.ac != "-" and $row.ac != ""
                ? ($isCountryView
                    ? $formatNumber($safeNumber($row.ac), "#0.0") & $config.unit_of_measure
                    : $formatNumber($safeNumber($row.ac), "#0"))
                : ""
            })]],
            "labels": $ensureArray(
              $map($entrySorted, function($v) {
                $v.raw_brand = "N/A"
                  ? ($lookup($countryMap, $v.country_iso_code_3) ?: $v.country_iso_code_3)
                  : $v.raw_brand
              })
            ),
            "icons": $ensureArray($entrySorted.("")),
            "suggestedMax": $suggestedMax,
            "hasPercentage": $isCountryView,
            "variationCaptionData": $isCountryView
              ? []
              : [
                  {
                    "title": $config.variation_caption.title,
                    "subtitle": $config.variation_caption.subtitle,
                    "label": " ",
                    "data": $ensureArray(
                      $map($entrySorted, function($row) {
                        (
                          $val := $row.vs_guideline;
                          $numVal := $exists($val) and $type($val) = "number" ? $val : null;
                          $direction := $numVal != null ? ($numVal > 0 ? "up" : "down") : "down";
                          $color := $numVal != null ? ($direction = "up" ? $config.colors.variation_up : $config.colors.variation_down) : "";
                          [
                            {
                              "value": $numVal != null ? $string($numVal) : "-",
                              "unit_of_measure": "",
                              "color": $color
                            }
                          ]
                        )
                      })
                    )
                  }
                ],
            "horizontalDashedLine": $isCountryView ? [] : $horizontalDashedLine
          }
        }
  }
)
