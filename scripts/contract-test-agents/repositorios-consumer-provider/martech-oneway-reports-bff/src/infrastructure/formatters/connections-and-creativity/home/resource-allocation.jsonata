/**
 * CONNECTIONS AND CREATIVITY HOME RESOURCE ALLOCATION FORMATTER
 * Component: Connections and Creativity Home - Resource Allocation
 * Used on: Connections and Creativity > Home
 */
(
  $megabrandsQwoaData := datasources."megabrands-qwoa";
  $campaignsQwoaData := datasources."campaigns-qwoa";

  /* Get the reference dt_end from megabrandsQwoa (filtered by view) */
  $referenceDtEnd := $megabrandsQwoaData[0].dt_end;

  /* Filter each datasource by the reference dt_end */
  $megabrandsQwoaLast := $megabrandsQwoaData[dt_end = $referenceDtEnd][0];
  $campaignsQwoaLast := $campaignsQwoaData[dt_end = $referenceDtEnd][0];

  /* Format value - returns "-" for null/undefined values */
  $formatValue := function($value) {
    $exists($value) and $type($value) = "number" ?
      $formatNumber($value, '#,##0.0')
      : "-"
  };

  /* Map direction to trend */
  $mapTrend := function($direction) {
    $direction = "up" ? "positive" : "negative"
  };

  {
    "megabrandsQwoaBigNumber": {
      "title": "Megabrands QWOA",
      "period": $megabrandsQwoaLast.refreshMonthLabel,
      "bigNumberData": $count($megabrandsQwoaLast) < 1 ? [] : [
        {
          "bigNumber": {
            "value": $formatValue($megabrandsQwoaLast.ac_vs_ly),
            "measure": "pp",
            "trend": $mapTrend($megabrandsQwoaLast.variationDirectionVsLy)
          },
          "comparison": {
            "label": "vs",
            "value": "LY"
          },
          "secondaryInfo": {
            "label": "[ % ]",
            "value": $formatValue($megabrandsQwoaLast.ac)
          }
        }
      ]
    },
    "campaignsQwoaBigNumber": {
      "title": "Campaigns QWOA",
      "period": $campaignsQwoaLast.refreshMonthLabel,
      "bigNumberData": $count($campaignsQwoaLast) < 1 ? [] : [
        {
          "bigNumber": {
            "value": $formatValue($campaignsQwoaLast.ac_vs_ly),
            "measure": "pp",
            "trend": $mapTrend($campaignsQwoaLast.variationDirectionVsLy)
          },
          "comparison": {
            "label": "vs",
            "value": "LY"
          },
          "secondaryInfo": {
            "label": "[ % ]",
            "value": $formatValue($campaignsQwoaLast.ac)
          }
        }
      ]
    }
  }
)
