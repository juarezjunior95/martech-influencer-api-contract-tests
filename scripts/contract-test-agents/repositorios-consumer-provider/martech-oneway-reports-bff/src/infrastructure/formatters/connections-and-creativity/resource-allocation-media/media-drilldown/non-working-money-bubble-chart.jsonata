(
  /**
   * 🎯 Component: Non-Working Money Bubble Chart (NWM guideline adherence by segment)
   * 📍 Used on: Resource Allocation Media > Media Drilldown
   * 🔄 Input: media-drilldown_non-working-money-bubble-chart, media-drilldown_non-working-money-guideline
   * 📤 Output: Chart, Legend
   * 🔧 Config: ds_keys, segment_order, chart (yAxis, thresholds, bubbles, info, backgrounds, caption), legend
   */

  /* ─── Config ─── */
  $config := {
    "ds_keys": {
      "main": "connections-and-creativity_resource-allocation-media_media-drilldown_non-working-money-bubble-chart",
      "guideline": "connections-and-creativity_resource-allocation-media_media-drilldown_non-working-money-guideline"
    },
    "segment_order": ["Megabrands", "Expansion", "Sustain"],
    "megabrands_icon": "<svg width='18' height='18' viewBox='0 0 18 18' fill='none' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' clip-rule='evenodd' d='M8.62502 1.27275C4.35737 1.27275 0.897749 4.73237 0.897749 9.00002C0.897749 13.2677 4.35737 16.7273 8.62502 16.7273C12.8927 16.7273 16.3523 13.2677 16.3523 9.00002C16.3523 4.73237 12.8927 1.27275 8.62502 1.27275ZM0.352295 9.00002C0.352295 4.43112 4.05612 0.727295 8.62502 0.727295C13.1939 0.727295 16.8978 4.43112 16.8978 9.00002C16.8978 13.5689 13.1939 17.2728 8.62502 17.2728C4.05612 17.2728 0.352295 13.5689 0.352295 9.00002ZM8.68245 5.46791C8.77683 5.46765 8.86465 5.5162 8.91461 5.59628L10.8653 8.72313L14.0951 6.41616C14.1905 6.34802 14.3187 6.34847 14.4137 6.41728C14.5086 6.48609 14.5489 6.60786 14.5138 6.71972L13.0284 11.4545C12.9927 11.5682 12.8873 11.6456 12.7682 11.6456H6.98116C6.83053 11.6456 6.70843 11.5235 6.70843 11.3729C6.70843 11.2223 6.83053 11.1002 6.98116 11.1002H12.5679L13.7497 7.33317L10.9461 9.33573C10.8848 9.37949 10.8082 9.39598 10.7344 9.38129C10.6605 9.3666 10.596 9.32204 10.5562 9.25816L8.68467 6.25823L6.7801 9.3497C6.74011 9.41461 6.67478 9.45982 6.59994 9.47436C6.5251 9.48891 6.44759 9.47146 6.38619 9.42626L3.64384 7.40689L5.17175 12.4309H9.08552C9.23614 12.4309 9.35825 12.553 9.35825 12.7036C9.35825 12.8542 9.23614 12.9763 9.08552 12.9763H4.96963C4.84958 12.9763 4.74364 12.8978 4.70871 12.783L2.88286 6.77933C2.84867 6.6669 2.89035 6.5452 2.98629 6.47733C3.08224 6.40946 3.21087 6.41068 3.3055 6.48037L6.47108 8.81139L8.45102 5.59759C8.50052 5.51723 8.58806 5.46818 8.68245 5.46791ZM10.5459 12.7034C10.5459 12.5528 10.668 12.4307 10.8187 12.4307H12.3969C12.5476 12.4307 12.6697 12.5528 12.6697 12.7034C12.6697 12.854 12.5476 12.9761 12.3969 12.9761H10.8187C10.668 12.9761 10.5459 12.854 10.5459 12.7034Z' fill='#141414'/><path fill-rule='evenodd' clip-rule='evenodd' d='M0.102295 9.00002C0.102295 4.29305 3.91805 0.477295 8.62502 0.477295C13.332 0.477295 17.1478 4.29305 17.1478 9.00002C17.1478 13.707 13.332 17.5228 8.62502 17.5228C3.91805 17.5228 0.102295 13.707 0.102295 9.00002ZM8.62502 0.977295C4.19419 0.977295 0.602295 4.56919 0.602295 9.00002C0.602295 13.4309 4.19419 17.0228 8.62502 17.0228C13.0559 17.0228 16.6478 13.4309 16.6478 9.00002C16.6478 4.56919 13.0559 0.977295 8.62502 0.977295ZM8.62502 1.52275C4.49544 1.52275 1.14775 4.87044 1.14775 9.00002C1.14775 13.1296 4.49544 16.4773 8.62502 16.4773C12.7546 16.4773 16.1023 13.1296 16.1023 9.00002C16.1023 4.87044 12.7546 1.52275 8.62502 1.52275ZM0.647749 9.00002C0.647749 4.5943 4.2193 1.02275 8.62502 1.02275C13.0307 1.02275 16.6023 4.5943 16.6023 9.00002C16.6023 13.4057 13.0307 16.9773 8.62502 16.9773C4.2193 16.9773 0.647749 13.4057 0.647749 9.00002ZM8.68174 5.21791C8.86265 5.2174 9.03096 5.31047 9.12671 5.46396L10.9365 8.36502L13.9498 6.21273C14.1326 6.08212 14.3785 6.08298 14.5604 6.21487C14.7423 6.34676 14.8196 6.58016 14.7523 6.79456L13.2669 11.5294C13.1985 11.7473 12.9966 11.8956 12.7682 11.8956H6.98116C6.69246 11.8956 6.45843 11.6616 6.45843 11.3729C6.45843 11.0842 6.69246 10.8502 6.98116 10.8502H12.3843L13.2878 7.97033L11.0914 9.53917C10.974 9.62304 10.8271 9.65464 10.6856 9.62649C10.5441 9.59833 10.4205 9.51292 10.3441 9.39049L8.686 6.73269L6.99295 9.48083C6.91631 9.60524 6.79108 9.69189 6.64763 9.71977C6.50419 9.74765 6.35562 9.71421 6.23796 9.62757L4.10222 8.05489L5.35703 12.1809H9.08552C9.37421 12.1809 9.60825 12.4149 9.60825 12.7036C9.60825 12.9923 9.37421 13.2263 9.08552 13.2263H4.96963C4.73952 13.2263 4.53648 13.0759 4.46952 12.8557L2.64368 6.85208C2.57814 6.63657 2.65802 6.40331 2.84192 6.27323C3.02581 6.14315 3.27236 6.14549 3.45374 6.27906L6.40067 8.44907L8.23817 5.46646C8.33306 5.31243 8.50084 5.21842 8.68174 5.21791ZM8.7025 5.72861C8.69833 5.72193 8.69101 5.71789 8.68315 5.71791C8.67529 5.71793 8.66799 5.72202 8.66387 5.72872L6.68393 8.94252C6.64728 9.00202 6.58739 9.04346 6.51878 9.0568C6.45018 9.07013 6.37912 9.05414 6.32285 9.0127L3.15727 6.68168C3.14938 6.67587 3.13866 6.67577 3.13067 6.68143C3.12267 6.68708 3.1192 6.69722 3.12205 6.70659L4.94789 12.7102C4.9508 12.7198 4.95963 12.7263 4.96963 12.7263H9.08552C9.09807 12.7263 9.10825 12.7162 9.10825 12.7036C9.10825 12.691 9.09807 12.6809 9.08552 12.6809H5.17175C5.0617 12.6809 4.96459 12.6089 4.93257 12.5036L3.40465 7.47963C3.37331 7.37656 3.41151 7.265 3.49946 7.20279C3.58741 7.14057 3.70533 7.1417 3.79208 7.20558L6.53443 9.22495C6.53955 9.22871 6.54601 9.23017 6.55224 9.22896C6.55848 9.22774 6.56392 9.22398 6.56726 9.21857L8.47182 6.1271C8.5172 6.05344 8.59745 6.00848 8.68397 6.00823C8.77049 6.00799 8.85098 6.0525 8.89678 6.12591L10.7683 9.12584C10.7716 9.13116 10.777 9.13487 10.7831 9.1361C10.7893 9.13732 10.7957 9.13595 10.8008 9.1323L13.6044 7.12974C13.6918 7.06727 13.8094 7.06769 13.8964 7.13076C13.9834 7.19384 14.0204 7.30547 13.9882 7.408L12.8064 11.175C12.7737 11.2792 12.6771 11.3502 12.5679 11.3502H6.98116C6.9686 11.3502 6.95843 11.3603 6.95843 11.3729C6.95843 11.3855 6.9686 11.3956 6.98116 11.3956H12.7682C12.7781 11.3956 12.7869 11.3892 12.7898 11.3797L14.2753 6.64489C14.2782 6.63557 14.2748 6.62542 14.2669 6.61969C14.259 6.61395 14.2483 6.61391 14.2404 6.61959L11.0106 8.92657C10.9545 8.96668 10.8842 8.9818 10.8165 8.96833C10.7488 8.95486 10.6897 8.91401 10.6532 8.85546L8.7025 5.72861ZM10.2959 12.7034C10.2959 12.4147 10.53 12.1807 10.8187 12.1807H12.3969C12.6856 12.1807 12.9197 12.4147 12.9197 12.7034C12.9197 12.9921 12.6856 13.2261 12.3969 13.2261H10.8187C10.53 13.2261 10.2959 12.9921 10.2959 12.7034ZM10.8187 12.6807C10.8061 12.6807 10.7959 12.6909 10.7959 12.7034C10.7959 12.716 10.8061 12.7261 10.8187 12.7261H12.3969C12.4095 12.7261 12.4197 12.716 12.4197 12.7034C12.4197 12.6909 12.4095 12.6807 12.3969 12.6807H10.8187Z' fill='black'/></svg>",
    "chart": {
      "yAxis": { "min": -3, "max": 110 },
      "thresholds": [17, 17],
      "bubble_radius": { "global": 10, "default": 9 },
      "guideline_fallback": 20,
      "bubbles": {
        "background_color": ["#1B560680", "#E5B6118F",  "#86393980"],
        "hover_background_color": ["#1B5606", "#E5B611", "#863939"]
      },
      "info": {
        "label": "Eixos"
      },
      "backgrounds": [
        { "color": "#BCDAB452", "hoverColor": "#BCDAB4" },
        { "color": "#E4E1A052", "hoverColor": "#E4E1A0" },
        { "color": "#DAB1B152", "hoverColor": "#DAB1B1" }
      ],
      "caption": {
        "title": "NWM Guideline adherence [%]",
        "subtitle": "",
        "data": {
          "color": "#1414148F",
          "unit_of_measure": "%"
        }        
      }      
    },
    "legend": {
      "color": "#C9D1D6",
      "border": "#14141420"
    }
  };


  $segments := $getSegmentColors();
  $datasources := $exists(components) and $count(components) > 0
    ? components[0].data.datasources
    : ($exists(datasources) ? datasources : {});
  $ds := $lookup($datasources, $config.ds_keys.main) ?: [];
  $guidelineDs := $lookup($datasources, $config.ds_keys.guideline) ?: [];

  $countries := $distinct($ds.country_iso_code_3);
  $isCountryView := $count($countries) > 1;

  $firstCountry := $count($ds) > 0 ? $ds[0].country_iso_code_3 : null;
  $rowsByCountry := $exists($firstCountry) ? $ds[country_iso_code_3 = $firstCountry] : [];

  $guidelineByCountry := $count($guidelineDs) > 0 and $exists($firstCountry)
    ? $guidelineDs[country_iso_code_3 = $firstCountry]
    : [];
  $guidelineRow := $count($guidelineByCountry) > 0 ? $guidelineByCountry[0] : null;
  $guidelineAc := $exists($guidelineRow) and $exists($guidelineRow.ac) ? $guidelineRow.ac : $config.chart.guideline_fallback;

  $preferredOrder := ["Megabrands", "Expansion", "Sustain", "Tail"];
  $combinedByCountry := $append($rowsByCountry, $guidelineByCountry);
  $rawSegments := $distinct($ensureArray($combinedByCountry[$exists($.segment)].segment));
  $distinctSegments := $filter($preferredOrder, function($seg) { $seg in $rawSegments });
  /* Datasets follow main data natural order, matching frontend's $distinct($datasource_nwm.segment) */
  $mainDataSegments := $distinct($ensureArray($rowsByCountry[$exists($.segment)].segment));
  $dataOrderSegments := $filter($mainDataSegments, function($seg) { $seg in $distinctSegments });

  $bubble := function($row) {
    (
      $ac := $exists($row.ac) and $type($row.ac) = "number" ? $row.ac : 0;
      $isGlobalBrand := $row.global_brand = "Global Brand";
      $t1 := $config.chart.thresholds[0];
      $t2 := $config.chart.thresholds[1];
      $bubbleObj := {
        "y": $ac,
        "r": $isGlobalBrand ? $config.chart.bubble_radius.global : $config.chart.bubble_radius.default,
        "tooltip": $row.raw_brand & ": " & $string($round($ac)) & "%",
        "backgroundColor": $ac < $t1
          ? $config.chart.bubbles.background_color[0]
          : $ac >= $t1 and $ac <= $t2
            ? $config.chart.bubbles.background_color[1]
            : $config.chart.bubbles.background_color[2],
        "hoverBackgroundColor": $ac < $t1
          ? $config.chart.bubbles.hover_background_color[0]
          : $ac >= $t1 and $ac <= $t2
            ? $config.chart.bubbles.hover_background_color[1]
            : $config.chart.bubbles.hover_background_color[2]
      };
      $isGlobalBrand ? $merge([$bubbleObj, { "pointStyle": "rectRot" }]) : $bubbleObj
    )
  };

  $datasetForSegment := function($segmentName) {
    (
      $segmentRows := $rowsByCountry[segment = $segmentName];
      $bubbleList := $count($segmentRows) > 0 ? $map($segmentRows, function($row) { $bubble($row) }) : [];
      $bubblesArray := $type($bubbleList) = "array" ? $bubbleList : [$bubbleList];
      {
        "bubbles": $bubblesArray
      }
    )
  };

  /* ─── Country View helpers ─── */
  $getCountryImage := function($c) {
    (
      $glRow := ($guidelineDs[country_iso_code_3 = $c])[0];
      $mainRow := ($ds[country_iso_code_3 = $c])[0];
      $exists($glRow.country_flag) ? $glRow.country_flag
        : $exists($mainRow.country) and $exists($mainRow.country.imageIcon) ? $mainRow.country.imageIcon
        : null
    )
  };

  $countryLabels := $isCountryView ? $map($countries, function($c) {
    { "text": $c, "image": $getCountryImage($c) }
  }) : [];

  $countryCaptionData := $isCountryView ? $map($countries, function($c) {
    (
      $gl := ($guidelineDs[country_iso_code_3 = $c])[0];
      $val := $exists($gl) and $exists($gl.ac) and $type($gl.ac) = "number" ? $gl.ac : 0;
      { "color": $config.chart.caption.data.color, "value": $val, "unit_of_measure": $config.chart.caption.data.unit_of_measure }
    )
  }) : [];

  $countryDatasets := $isCountryView ? $map($countries, function($c) {
    (
      $cRows := $ds[country_iso_code_3 = $c];
      $bList := $count($cRows) > 0 ? $map($cRows, function($row) { $bubble($row) }) : [];
      $bArr := $type($bList) = "array" ? $bList : [$bList];
      { "bubbles": $bArr }
    )
  }) : [];

  $chartBackgrounds := [
    { "from": $config.chart.yAxis.min, "to": $config.chart.thresholds[0], "color": $config.chart.backgrounds[0].color, "hoverColor": $config.chart.backgrounds[0].hoverColor },
    { "from": $config.chart.thresholds[0], "to": $config.chart.thresholds[1], "color": $config.chart.backgrounds[1].color, "hoverColor": $config.chart.backgrounds[1].hoverColor },
    { "from": $config.chart.thresholds[1], "to": $config.chart.yAxis.max, "color": $config.chart.backgrounds[2].color, "hoverColor": $config.chart.backgrounds[2].hoverColor }
  ];

  $legendItems := [
    { "color": $config.legend.color, "pointStyle": "rectRot", "label": "Global Brands", "border": $config.legend.border },
    { "color": $config.legend.color, "pointStyle": "circle", "label": "Brands", "border": $config.legend.border }
  ];

  $count($ds) = 0
    ? { "non_working_money": { "Chart": {}, "Legend": [] } }
    : $isCountryView
      ? {
          "non_working_money": {
            "Chart": {
              "yAxis": $config.chart.yAxis,
              "info": { "label": $config.chart.info.label },
              "backgroundChart": { "backgrounds": $chartBackgrounds },
              "label": $countryLabels,
              "caption": {
                "title": $config.chart.caption.title,
                "subtitle": $config.chart.caption.subtitle,
                "data": $countryCaptionData
              },
              "datasets": $countryDatasets
            },
            "Legend": $legendItems
          }
        }
      : {
          "non_working_money": {
            "Chart": {
              "yAxis": $config.chart.yAxis,
              "info": { "label": $config.chart.info.label },
              "backgroundChart": { "backgrounds": $chartBackgrounds },
              "label": [$map($distinctSegments, function($seg) {
                $merge([
                  { "text": $seg, "portfolioColor": $lookup($segments, $seg) },
                  $lowercase($seg) = "megabrands" ? { "icon": $config.megabrands_icon } : {}
                ])
              })],
              "caption": {
                "title": $config.chart.caption.title,
                "subtitle": $config.chart.caption.subtitle,
                "data": [$map($distinctSegments, function($seg) {
                  (
                    $glRow := ($guidelineByCountry[segment = $seg])[0];
                    $val := $exists($glRow) and $exists($glRow.ac) and $type($glRow.ac) = "number" ? $glRow.ac : 0;
                    { "color": $config.chart.caption.data.color, "value": $val, "unit_of_measure": $config.chart.caption.data.unit_of_measure }
                  )
                })]
              },
              "datasets": [$map($dataOrderSegments, function($seg) { $datasetForSegment($seg) })]
            },
            "Legend": $legendItems
          }
        }
)
