# Application Configuration
APP_PORT=8080
NODE_ENV=development

# Data Service Configuration
# URL of the data service microservice
DATA_SERVICE_BASE_URL=http://martech-oneway-reports-data-service:3030

# Redis Configuration
# Redis connection details for caching
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=mypassword!

# View Cache Configuration
# Enable/disable view caching (default: false)
VIEW_CACHE_ENABLED=false

# New Relic Configuration (Optional)
# Uncomment and configure if you want to use New Relic monitoring
# NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
# NEW_RELIC_APP_NAME=martech-oneway-reports-bff

# Logging Configuration (Optional)
# LOG_LEVEL=info

# Timeout Configuration (Optional)
# Request timeout in milliseconds
# TIMEOUT=20000

# Swagger Configuration (Optional)
# SWAGGER_ROUTE=/v1/docs
# SWAGGER_BASE_PATH=/api/martech-oneway-reports-bff
