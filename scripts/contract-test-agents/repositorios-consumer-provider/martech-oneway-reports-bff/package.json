{
  "name": "martech-oneway-reports-bff",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "./src/main.ts",
  "scripts": {
    "prepare": "husky",
    "build": "nest build",
    "branch": "./scripts/create-branch.sh",
    "commit": "git add . && git cz && git push origin $(git rev-parse --abbrev-ref HEAD)",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:provider": "jest --config jest.contract.config.json",
    "test:provider:broker": "node scripts-pact/broker.js",
    "test:provider:publish": "node scripts-pact/publish-broker.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/class-transformer": "^0.4.0",
    "@nestjs/class-validator": "^0.13.4",
    "@nestjs/common": "^11.1.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.7",
    "@nestjs/platform-express": "^11.1.7",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "5.1.0",
    "ioredis": "^5.8.2",
    "jsonata": "^2.1.0",
    "jwt-decode": "^4.0.0",
    "nest-winston": "^1.10.2",
    "newrelic": "^13.5.0",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@faker-js/faker": "^10.1.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.7",
    "@pact-foundation/pact": "^16.5.0",
    "@tsconfig/node20": "20.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jwt-decode": "^3.1.0",
    "@types/k6": "^1.3.1",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^24.9.1",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "git-commit-msg-linter": "^5.0.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "jest-mock-extended": "^4.0.0",
    "lint-staged": "^16.2.5",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
