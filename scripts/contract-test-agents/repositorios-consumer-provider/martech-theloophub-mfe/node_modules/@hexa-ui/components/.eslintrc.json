{
  "extends": ["../../.eslintrc"],
  "ignorePatterns": ["!**/*", "lib/table/react-table-config.d.ts"],
  "rules": {
    "react/require-default-props": ["off"],
    "import/no-extraneous-dependencies": [
      "off",
      {
        "devDependencies": [
          "**/*{.,_}{test,spec}.{js,jsx}",
          "**/setupTests.ts",
          "setup.test.js",
          "**/*.stories.*",
          "**/.storybook/**/*.*"
        ],
        "packageDir": ".",
        "peerDependencies": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    }
  ]
}
