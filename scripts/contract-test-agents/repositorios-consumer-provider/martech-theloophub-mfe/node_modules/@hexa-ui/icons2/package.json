{
  "name": "@hexa-ui/icons",
  "version": "2.0.0-beta.5",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "registry": "https://ab-inbev.pkgs.visualstudio.com/GHQ_B2B_Delta/_packaging/admin-portal-shared-services/npm/registry/"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react react-dom",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts --external react react-dom",
    "lint": "eslint src/ --fix",
    "clean": "rimraf .turbo && rimraf node_modules && rimraf dist",
    "generate-icons": "yarn svgr --out-dir src/components src/assets --typescript --icon --replace-attr-values '#141414=currentColor' && yarn lint"
  },
  "devDependencies": {
    "@hexa-ui/eslint-config": "*",
    "@hexa-ui/tsconfig": "*",
    "@svgr/cli": "^8.1.0",
    "@types/react": "^17.0.25",
    "@types/react-dom": "^17.0.25",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "tsup": "^6.0.1",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": ">= 17 & <= 18",
    "react-dom": ">= 17 & <= 18"
  }
}
