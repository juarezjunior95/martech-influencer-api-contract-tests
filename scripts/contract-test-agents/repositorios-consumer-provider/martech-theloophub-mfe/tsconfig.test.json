{
  "extends": "ts-config-single-spa",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2015",
    "esModuleInterop": true,
    "declarationDir": "dist",
    "baseUrl": "src",
    "paths": {
      "*": ["*"],
      "pact": ["pact/index.ts"]
    },
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "allowSyntheticDefaultImports": true
  },
  "files": ["src/martech-theloophub-mfe.tsx"],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
