{
  "name": "test-contrato-api-plataform-influencer",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pact:consumer": "vitest run tests/contract/consumer",
    "test:pact:consumer:partners": "vitest run tests/contract/consumer/partners-search.pact.spec.ts",
    "test:pact:consumer:brand-safety": "vitest run tests/contract/consumer/brand-safety-jobs-queued.pact.spec.ts",
    "test:pact:consumer:post-users": "vitest run tests/contract/consumer/post-users.pact.spec.ts",
    "test:pact:consumer:post-campaigns": "vitest run tests/contract/consumer/post-campaigns.pact.spec.ts",
    "test:pact:consumer:sprint204": "vitest run tests/contract/consumer/post-deck-brand-safety.pact.spec.ts tests/contract/consumer/post-brand-safety-complete.pact.spec.ts tests/contract/consumer/post-brand-safety-expire.pact.spec.ts",
    "pact:backlog-report": "tsx scripts/generate-pact-backlog-report.ts",
    "openapi:extract-uat": "tsx scripts/extract-openapi-from-swagger-init.ts",
    "pact:openapi-gap-report": "tsx scripts/pact-openapi-gap-report.ts",
    "pact:endpoint-backlog": "tsx scripts/generate-pact-endpoint-backlog.ts",
    "pact:dashboard-report": "cp docs/pact-contract-testing-dashboard.html reports/pact-contract-testing-dashboard.html && echo 'Dashboard: reports/pact-contract-testing-dashboard.html'",
    "test:pact:consumer:all": "vitest run tests/contract/consumer tests/consumer",
    "pact:verify-provider": "tsx scripts/verify-provider.ts",
    "pact:verify-provider:broker": "PACT_BROKER_BASE_URL=http://localhost:9292 PACT_VERIFY_FROM_BROKER=true tsx scripts/verify-provider.ts",
    "pact:verify-provider:mock": "sh scripts/pact-verify-mock-provider.sh",
    "test:pact:consumer:t2720": "vitest run tests/contract/consumer/submitter.campaigns.pact.spec.ts -t T2720",
    "pact:t2720:verify-publish": "sh scripts/pact-t2720-verify-publish.sh",
    "pact:publish": "sh scripts/publish-pacts.sh",
    "docker:broker:up": "docker compose up -d postgres pact-broker",
    "docker:broker:down": "docker compose down",
    "docker:broker:logs": "docker compose logs -f pact-broker",
    "docker:test:publish": "docker compose --profile test up --build --abort-on-container-exit",
    "pact:flow": "npm run docker:broker:up && npm run test:pact:consumer && npm run pact:publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@pact-foundation/pact": "^16.5.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
